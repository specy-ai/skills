{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specy.ai/schemas/architecture/1.json",
  "title": "Specy software architecture",
  "description": "A .arch model as a document: what `specy convert --to json|yaml` emits and reads back into a .arch file. One root per document: `architecture` (one system in focus, C4 levels 1–3: persons, external systems, the system with its Thrift-typed contracts, containers, components, channels, connectors and deployment) or `organization` (level 0: the systems of an organization, what each masters and handles, the dependencies between them and the numbered flows of domain concepts along each dependency; a system may carry its levels 2–3 inline under `detail`). DSL keywords are kept as strings; references are the names as written (`Finance.Invoice`, `LinkController.LinkCommands`).",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "parser": { "$ref": "#/$defs/parser" },
    "architecture": { "$ref": "#/$defs/architecture" },
    "organization": { "$ref": "#/$defs/organization" }
  },
  "additionalProperties": false,
  "$defs": {
    "parser": {
      "type": "object",
      "description": "Which parser wrote the document; consumers pin the minimum version whose shape they understand.",
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "description": "The `meta { key = value }` block: free key/value annotations.",
      "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
    },
    "satisfies": { "type": "array", "description": "Requirement ids (REQ-…) this element satisfies.", "items": { "type": "string" } },
    "names": { "type": "array", "items": { "type": "string" } },
    "concepts": {
      "type": "array",
      "description": "Domain concept references, bare (`Invoice`) or qualified by their bounded context (`Finance.Invoice`).",
      "items": { "type": "string" }
    },
    "realizes": {
      "type": "array",
      "description": "Traceability links to domain elements: a module, a context, an interface, an event or a value type, by name.",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "enum": ["module", "context", "interface", "event", "value type"] },
          "name": { "type": "string" }
        },
        "required": ["kind", "name"],
        "additionalProperties": false
      }
    },
    "described": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "externalSystem": {
      "type": "object",
      "description": "A system outside the one in focus (or outside the organization). It provides or consumes interfaces; in an organization it may also master concepts.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "realizes": { "$ref": "#/$defs/realizes" },
        "provides": { "$ref": "#/$defs/names" },
        "consumes": { "$ref": "#/$defs/names" },
        "masters": { "$ref": "#/$defs/concepts" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "fieldType": { "type": "string", "description": "A primitive (string, int, long, double, decimal, boolean, date, datetime, time, instant, duration, uuid, binary), a collection (list<…>, set<…>, map<…, …>) or a named type." },
    "literal": { "type": ["string", "number", "boolean", "null"] },
    "field": {
      "type": "object",
      "description": "A Thrift-style field: ordinal, requiredness, type, name, optional default.",
      "properties": {
        "ordinal": { "type": "integer" },
        "requiredness": { "type": "string", "enum": ["required", "optional"] },
        "type": { "$ref": "#/$defs/fieldType" },
        "name": { "type": "string" },
        "default": { "$ref": "#/$defs/literal" },
        "description": { "type": "string" }
      },
      "required": ["ordinal", "requiredness", "type", "name"],
      "additionalProperties": false
    },
    "type": {
      "type": "object",
      "description": "A named type of the system: struct, exception, union, enum, typedef, or a value type / event imported from the domain.",
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "struct" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "metadata": { "$ref": "#/$defs/metadata" },
            "satisfies": { "$ref": "#/$defs/satisfies" },
            "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
          },
          "required": ["kind", "name", "fields"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "exception" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "metadata": { "$ref": "#/$defs/metadata" },
            "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
          },
          "required": ["kind", "name", "fields"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "union" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "metadata": { "$ref": "#/$defs/metadata" },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": { "ordinal": { "type": "integer" }, "type": { "$ref": "#/$defs/fieldType" }, "name": { "type": "string" } },
                "required": ["ordinal", "type", "name"],
                "additionalProperties": false
              }
            }
          },
          "required": ["kind", "name", "members"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "enum" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "metadata": { "$ref": "#/$defs/metadata" },
            "members": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": { "name": { "type": "string" }, "value": { "type": "integer" } },
                "required": ["name", "value"],
                "additionalProperties": false
              }
            }
          },
          "required": ["kind", "name", "members"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "typedef" },
            "name": { "type": "string" },
            "type": { "$ref": "#/$defs/fieldType" }
          },
          "required": ["kind", "name", "type"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "import" },
            "name": { "type": "string" },
            "imports": { "type": "string", "enum": ["value type", "event"], "description": "What the domain element is: a value type behaves as a named field type, an event as a message contract." }
          },
          "required": ["kind", "name", "imports"],
          "additionalProperties": false
        }
      ]
    },
    "operation": {
      "type": "object",
      "description": "A technical signature with its interaction style: bare = request-response (a command), safe = no mutation (a query), oneway = fire-and-forget (returns void), streaming = a stream of results.",
      "properties": {
        "style": { "type": "string", "enum": ["safe", "oneway", "streaming"] },
        "name": { "type": "string" },
        "args": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ordinal": { "type": "integer" },
              "requiredness": { "type": "string", "enum": ["required", "optional"] },
              "type": { "$ref": "#/$defs/fieldType" },
              "name": { "type": "string" },
              "default": { "$ref": "#/$defs/literal" }
            },
            "required": ["ordinal", "requiredness", "type", "name"],
            "additionalProperties": false
          }
        },
        "returns": { "type": "string", "description": "A field type, or `void`." },
        "throws": { "$ref": "#/$defs/names" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" }
      },
      "required": ["name", "returns"],
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "description": "A first-class named contract: a set of operations, provided and required through ports.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "satisfies": { "$ref": "#/$defs/satisfies" },
        "realizes": { "$ref": "#/$defs/realizes" },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "description": "Level 3: the finest logical unit, inside a container.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "satisfies": { "$ref": "#/$defs/satisfies" },
        "realizes": { "$ref": "#/$defs/realizes" },
        "boundedContext": { "type": "string" },
        "provides": { "$ref": "#/$defs/names" },
        "requires": { "$ref": "#/$defs/names" },
        "publishes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "message": { "type": "string" }, "channel": { "type": "string" } },
            "required": ["message", "channel"],
            "additionalProperties": false
          }
        },
        "subscribes": { "$ref": "#/$defs/names" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "container": {
      "type": "object",
      "description": "Level 2: a runnable or deployable unit, identified by its free-form technology.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "technology": { "type": "string" },
        "satisfies": { "$ref": "#/$defs/satisfies" },
        "realizes": { "$ref": "#/$defs/realizes" },
        "provides": { "$ref": "#/$defs/names" },
        "requires": { "$ref": "#/$defs/names" },
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "description": "A first-class async topic or queue hosted on a broker container, carrying message types.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "broker": { "type": "string" },
        "carries": { "$ref": "#/$defs/names" }
      },
      "required": ["name", "broker", "carries"],
      "additionalProperties": false
    },
    "connector": {
      "type": "object",
      "description": "A wire from a consumer (or required port) to a provider (or provided port): `from` and `to` are dotted references such as `LinkController.LinkCommands`.",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "protocol": { "type": "string" },
        "style": { "type": "string", "enum": ["sync", "async", "streaming"] },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" }
      },
      "required": ["from", "to", "protocol", "style"],
      "additionalProperties": false
    },
    "deploy": {
      "type": "object",
      "properties": { "containers": { "$ref": "#/$defs/names" }, "replicas": { "type": "integer" } },
      "required": ["containers"],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "description": "A provisioned unit of infrastructure: where data physically lives.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "instantiates": { "type": "string" },
        "technology": { "type": "string" },
        "tenancy": { "type": "string", "enum": ["shared", "dedicated"] },
        "stores": { "$ref": "#/$defs/names" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "description": "Where containers run (a region, a cluster, a VM, a serverless runtime). Nodes nest.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "provider": { "type": "string" },
        "region": { "type": "string" },
        "zone": { "type": "string" },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "deploys": { "type": "array", "items": { "$ref": "#/$defs/deploy" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "deploys": { "type": "array", "items": { "$ref": "#/$defs/deploy" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "systemMembers": {
      "description": "The members of a system body (levels 2 and 3), grouped by kind.",
      "properties": {
        "boundedContexts": { "type": "array", "items": { "$ref": "#/$defs/described" } },
        "types": { "type": "array", "items": { "$ref": "#/$defs/type" } },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "containers": { "type": "array", "items": { "$ref": "#/$defs/container" } },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } },
        "environments": { "type": "array", "items": { "$ref": "#/$defs/environment" } }
      }
    },
    "system": {
      "type": "object",
      "description": "The one system in focus of an `architecture` document.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "satisfies": { "$ref": "#/$defs/satisfies" },
        "realizes": { "$ref": "#/$defs/realizes" },
        "boundedContexts": { "type": "array", "items": { "$ref": "#/$defs/described" } },
        "types": { "type": "array", "items": { "$ref": "#/$defs/type" } },
        "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
        "containers": { "type": "array", "items": { "$ref": "#/$defs/container" } },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } },
        "environments": { "type": "array", "items": { "$ref": "#/$defs/environment" } }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "description": "Levels 1–3: the persons and external systems around one system, and the system itself.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "domainSources": { "$ref": "#/$defs/names", "description": "Paths of the .domain files the realizes / import references resolve against." },
        "requirementsSource": { "type": "string", "description": "Path of the .sysreq file the satisfies references resolve against." },
        "persons": { "type": "array", "items": { "$ref": "#/$defs/described" } },
        "externalSystems": { "type": "array", "items": { "$ref": "#/$defs/externalSystem" } },
        "system": { "$ref": "#/$defs/system" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "hotspot": {
      "type": "object",
      "description": "A known point of fragility or effort in operating the system; `concerns` names flows (by number) and domain concepts.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "concerns": { "type": "array", "items": { "type": ["integer", "string"] } }
      },
      "required": ["name", "description"],
      "additionalProperties": false
    },
    "orgSystem": {
      "type": "object",
      "description": "A system of the organization, described from the outside: its purpose (`description`), product (`technology`), area, users, the concepts it masters (system of record) and handles, its hotspots; `detail` carries levels 2–3 when the system is detailed inline, `detailedIn` names the single-system .arch file otherwise.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "technology": { "type": "string" },
        "satisfies": { "$ref": "#/$defs/satisfies" },
        "realizes": { "$ref": "#/$defs/realizes" },
        "area": { "type": "string" },
        "usedBy": { "$ref": "#/$defs/names" },
        "masters": { "$ref": "#/$defs/concepts" },
        "handles": { "$ref": "#/$defs/concepts" },
        "hotspots": { "type": "array", "items": { "$ref": "#/$defs/hotspot" } },
        "detailedIn": { "type": "string" },
        "detail": {
          "type": "object",
          "properties": {
            "boundedContexts": { "type": "array", "items": { "$ref": "#/$defs/described" } },
            "types": { "type": "array", "items": { "$ref": "#/$defs/type" } },
            "interfaces": { "type": "array", "items": { "$ref": "#/$defs/interface" } },
            "containers": { "type": "array", "items": { "$ref": "#/$defs/container" } },
            "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
            "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } },
            "environments": { "type": "array", "items": { "$ref": "#/$defs/environment" } }
          },
          "additionalProperties": false
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "mechanism": {
      "properties": {
        "over": { "type": "string", "description": "The medium: a file format, an API, a connector." },
        "mode": { "type": "string", "enum": ["manual", "automated"], "description": "Whether a person performs the transfer." }
      }
    },
    "flow": {
      "type": "object",
      "description": "One numbered, named movement of domain concepts along a dependency. Data goes from the upstream system to the downstream one unless `to` names the receiver. The mechanism is stated once, or per phase, or not at all (undecided).",
      "properties": {
        "number": { "type": "integer" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "carries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "concept": { "type": "string" },
              "as": { "type": "string", "description": "What the concept becomes in the receiver's model." }
            },
            "required": ["concept"],
            "additionalProperties": false
          }
        },
        "to": { "type": "string" },
        "mechanism": {
          "type": "object",
          "properties": { "over": { "type": "string" }, "mode": { "type": "string", "enum": ["manual", "automated"] } },
          "additionalProperties": false
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": { "type": "string" },
              "over": { "type": "string" },
              "mode": { "type": "string", "enum": ["manual", "automated"] }
            },
            "required": ["phase"],
            "additionalProperties": false
          }
        }
      },
      "required": ["number", "label", "carries"],
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "description": "`downstream` depends on `upstream`: the direction of the need, not of the call. Patterns are the context-map patterns (CS, Conformist, ACL on the downstream side; OHS upstream; SharedKernel, PublishedLanguage, Partnership on both); criticality says what the downstream system suffers when the upstream one is unavailable.",
      "properties": {
        "downstream": { "type": "string" },
        "upstream": { "type": "string" },
        "patterns": { "type": "array", "items": { "type": "string", "enum": ["CS", "Conformist", "ACL", "OHS", "SharedKernel", "PublishedLanguage", "Partnership"] } },
        "criticality": { "type": "string", "enum": ["critical", "degraded", "tolerant"] },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "flows": { "type": "array", "items": { "$ref": "#/$defs/flow" } }
      },
      "required": ["downstream", "upstream"],
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "description": "Level 0: the system landscape of one organization.",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "domainSources": { "$ref": "#/$defs/names" },
        "requirementsSource": { "type": "string" },
        "phases": { "type": "array", "description": "Stages of the integration roadmap, in chronological order.", "items": { "$ref": "#/$defs/described" } },
        "areas": { "type": "array", "description": "Groupings of systems as the business sees its landscape.", "items": { "$ref": "#/$defs/described" } },
        "persons": { "type": "array", "items": { "$ref": "#/$defs/described" } },
        "externalSystems": { "type": "array", "items": { "$ref": "#/$defs/externalSystem" } },
        "systems": { "type": "array", "items": { "$ref": "#/$defs/orgSystem" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } }
      },
      "required": ["name"],
      "additionalProperties": false
    }
  }
}
