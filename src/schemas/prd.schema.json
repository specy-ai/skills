{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specy.ai/schemas/prd/1.json",
  "title": "Specy product requirements document",
  "description": "A .prd file as a document: what `specy convert --to json|yaml` emits for a product requirements file, and what it reads back into a .prd. One object per product, its members grouped by kind in the metamodel's order (PRODUCT-REQ-METAMODEL.md): vision, scope, non-goals, the SCQ problem, evidence, personas, jobs, goals, hypotheses, features (with their stories and acceptance criteria), assumptions, risks, constraints, open questions, releases, journeys. Keywords keep the DSL's spelling (`must`, `nice-to-have`, `short-term`); features, stories and acceptance criteria keep their stable ids (FEAT-001, US-004, AC-004-02) when the file carries them.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "parser": { "$ref": "#/$defs/parser" },
    "products": { "type": "array", "items": { "$ref": "#/$defs/product" } }
  },
  "required": ["products"],
  "additionalProperties": false,
  "$defs": {
    "parser": {
      "type": "object",
      "description": "Which parser wrote the document; consumers pin the minimum version whose shape they understand.",
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "texts": { "type": "array", "items": { "type": "string" } },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD." },
    "level": { "type": "string", "enum": ["high", "medium", "low"] },
    "product": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "vision": { "type": "string" },
        "scope": { "$ref": "#/$defs/texts", "description": "What the product includes." },
        "nonGoals": { "$ref": "#/$defs/texts", "description": "Strategic exclusions." },
        "problem": {
          "type": "object",
          "description": "The problem statement in the Situation–Complication–Question frame.",
          "properties": { "situation": { "type": "string" }, "complication": { "type": "string" }, "question": { "type": "string" } },
          "required": ["situation", "complication", "question"],
          "additionalProperties": false
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "personas": { "type": "array", "items": { "$ref": "#/$defs/persona" } },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } },
        "goals": { "type": "array", "items": { "$ref": "#/$defs/goal" } },
        "hypotheses": { "type": "array", "items": { "$ref": "#/$defs/hypothesis" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature" } },
        "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
        "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "openQuestions": { "type": "array", "items": { "$ref": "#/$defs/openQuestion" } },
        "releases": { "type": "array", "items": { "$ref": "#/$defs/release" } },
        "journeys": { "type": "array", "items": { "$ref": "#/$defs/journey" } }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "description": "A piece of supporting evidence and the element (goal, job, …) it supports, by name.",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["user-research", "analytics", "market-research", "customer-feedback", "domain-expertise"] },
        "summary": { "type": "string" },
        "sourceReference": { "type": "string" },
        "date": { "$ref": "#/$defs/date" },
        "confidence": { "type": "string", "enum": ["strong", "moderate", "weak"] },
        "supports": { "type": "string" }
      },
      "required": ["name", "type", "summary", "sourceReference", "date", "confidence", "supports"],
      "additionalProperties": false
    },
    "persona": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "goals": { "$ref": "#/$defs/texts" },
        "frustrations": { "$ref": "#/$defs/texts" },
        "context": { "type": "string" },
        "weight": { "type": "string", "enum": ["primary", "secondary", "excluded"] }
      },
      "required": ["name", "role", "goals", "frustrations", "context", "weight"],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "description": "A situation-triggered task a persona is trying to accomplish (jobs-to-be-done).",
      "properties": {
        "name": { "type": "string" },
        "persona": { "type": "string", "description": "The persona's name." },
        "statement": { "type": "string", "description": "When …, I want …, so I can …" },
        "type": { "type": "string", "enum": ["functional", "emotional", "social"] },
        "importance": { "type": "string", "enum": ["critical", "important", "nice-to-have"] },
        "satisfaction": { "type": "string", "enum": ["unserved", "underserved", "adequately-served", "overserved"] },
        "relatedTo": { "$ref": "#/$defs/texts", "description": "Names of related jobs." },
        "desiredOutcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "statement": { "type": "string" },
              "importance": { "$ref": "#/$defs/level" },
              "currentSatisfaction": { "$ref": "#/$defs/level" }
            },
            "required": ["statement", "importance", "currentSatisfaction"],
            "additionalProperties": false
          }
        }
      },
      "required": ["name", "persona", "statement", "type", "importance", "satisfaction"],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "description": "A measurable business objective and its success metrics.",
      "properties": {
        "name": { "type": "string" },
        "statement": { "type": "string" },
        "horizon": { "type": "string", "enum": ["short-term", "mid-term", "long-term"] },
        "owner": { "type": "string" },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "indicator": { "type": "string" },
              "target": { "type": "string" },
              "baseline": { "type": "string" },
              "measurement": { "type": "string" }
            },
            "required": ["indicator", "target", "measurement"],
            "additionalProperties": false
          }
        }
      },
      "required": ["name", "statement", "horizon", "owner"],
      "additionalProperties": false
    },
    "hypothesis": {
      "type": "object",
      "description": "A testable causal claim: the feature it proposes, the goal it predicts.",
      "properties": {
        "name": { "type": "string" },
        "intervention": { "type": "string" },
        "expectedOutcome": { "type": "string" },
        "mechanism": { "type": "string" },
        "validationMethod": { "type": "string" },
        "status": { "type": "string", "enum": ["proposed", "testing", "validated", "invalidated", "inconclusive"] },
        "proposes": { "type": "string", "description": "The feature's name." },
        "predicts": { "type": "string", "description": "The goal's name." },
        "supportedBy": { "$ref": "#/$defs/texts", "description": "Names of supporting evidence." }
      },
      "required": ["name", "intervention", "expectedOutcome", "mechanism", "validationMethod", "status", "proposes", "predicts"],
      "additionalProperties": false
    },
    "designReference": {
      "type": "object",
      "properties": { "name": { "type": "string" }, "url": { "type": "string" } },
      "required": ["name", "url"],
      "additionalProperties": false
    },
    "feature": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^FEAT-\\d{3}$", "description": "Stable identifier; what a system requirement's `source` references." },
        "name": { "type": "string" },
        "summary": { "type": "string" },
        "persona": { "type": "string" },
        "valueProposition": { "type": "string" },
        "priority": { "type": "string", "enum": ["must", "should", "could", "wont"] },
        "status": { "type": "string", "enum": ["proposed", "accepted", "in-progress", "delivered", "deferred", "rejected"] },
        "addresses": { "$ref": "#/$defs/texts", "description": "Names of the jobs it addresses." },
        "advances": { "$ref": "#/$defs/texts", "description": "Names of the goals it advances." },
        "testedBy": { "type": "string", "description": "The hypothesis that tests it." },
        "designReferences": { "type": "array", "items": { "$ref": "#/$defs/designReference" } },
        "nonGoals": { "$ref": "#/$defs/texts" },
        "stories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^US-\\d{3}$" },
              "title": { "type": "string" },
              "acceptanceCriteria": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "pattern": "^AC-\\d{3}-\\d{2}$" },
                    "text": { "type": "string" }
                  },
                  "required": ["text"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["title", "acceptanceCriteria"],
            "additionalProperties": false
          }
        }
      },
      "required": ["name", "summary", "persona", "valueProposition", "priority", "status"],
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "statement": { "type": "string" },
        "impactIfWrong": { "type": "string" },
        "validationPlan": { "type": "string" },
        "status": { "type": "string", "enum": ["unvalidated", "validated", "invalidated"] },
        "underpins": { "$ref": "#/$defs/texts", "description": "Names of the elements that rest on it." }
      },
      "required": ["name", "statement", "impactIfWrong", "validationPlan", "status"],
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "statement": { "type": "string" },
        "likelihood": { "$ref": "#/$defs/level" },
        "impact": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "mitigation": { "type": "string", "enum": ["accept", "mitigate", "avoid", "transfer"] },
        "owner": { "type": "string" },
        "threatens": { "$ref": "#/$defs/texts", "description": "Names of the goals or features it threatens." }
      },
      "required": ["name", "statement", "likelihood", "impact", "mitigation", "owner"],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "statement": { "type": "string" },
        "source": { "type": "string", "enum": ["regulatory", "contractual", "technical", "organizational", "market"] },
        "constrains": { "$ref": "#/$defs/texts" }
      },
      "required": ["name", "statement", "source"],
      "additionalProperties": false
    },
    "openQuestion": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "question": { "type": "string" },
        "context": { "type": "string" },
        "owner": { "type": "string" },
        "deadline": { "$ref": "#/$defs/date" },
        "status": { "type": "string", "enum": ["open", "investigating", "resolved", "deferred"] },
        "blocks": { "$ref": "#/$defs/texts", "description": "Names of the elements it blocks." },
        "resolution": { "type": "string" }
      },
      "required": ["name", "question", "context", "owner", "deadline", "status"],
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "targetDate": { "type": "string" },
        "theme": { "type": "string" },
        "status": { "type": "string", "enum": ["planned", "in-progress", "shipped", "cancelled"] },
        "dependsOn": { "$ref": "#/$defs/texts", "description": "Names of the releases it depends on." },
        "includes": { "$ref": "#/$defs/texts", "description": "Names of the features it ships." },
        "entryCriteria": { "$ref": "#/$defs/texts" },
        "exitCriteria": { "$ref": "#/$defs/texts" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "journey": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "persona": { "type": "string" },
        "trigger": { "type": "string" },
        "outcome": { "type": "string" },
        "designReferences": { "type": "array", "items": { "$ref": "#/$defs/designReference" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
      },
      "required": ["name", "persona", "trigger", "outcome"],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "description": "A journey step, named by a number (`step 1`) or by what the persona does (the name then doubles as the action).",
      "properties": {
        "number": { "type": "number" },
        "name": { "type": "string" },
        "action": { "type": "string" },
        "systemResponse": { "type": "string" },
        "channel": { "type": "string", "enum": ["app", "web", "sms", "email", "physical", "backoffice", "external"] },
        "emotionalTone": { "type": "string", "enum": ["confident", "anxious", "frustrated", "delighted", "neutral"] },
        "order": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
