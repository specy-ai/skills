{
  "name": "specy-domain",
  "scopeName": "source.specy-domain",
  "fileTypes": [
    ".domain"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.specy-domain",
      "match": "\\b(ACL|CS|Conformist|OHS|Partnership|PublishedLanguage|SeparateWays|SharedKernel|about|action|aggregate|agreement|alert|and|api|application|as|asynchronous-projection|boolean|businessDay|businessDays|calls|caused-by|choreography|code|command|compensate|compensation|contain|contains|context|coordination|creates|d|date|datetime|days|decimal|default|defined|depends|described-by|describes|detection|does|domain|downstream|duplicate|duration|effects|else|emits|enforcement|entities|entity|enum|error|escalation|event|event-sourced|every|exists|exposed-by|exposes|external|false|fields|final|for|forall|foreach|from|future|futureOrPresent|guard|h|hours|id|idempotent|identity|if|immutable|in|infrastructure|instant|int|integer|interface|invariant|invariants|is|list|long|machine|manual|map|matches|max|maxLength|message|meta|min|minLength|minutes|module|months|ms|must|name|not|null|of|offset|on|operations|optional|or|orchestration|ordered|organization|participants|past|pastOrPresent|pattern|postcondition|precondition|predicate|projected-by|query|range|reaction|read-only|reads-from|reconciliation|reference|references|rejection|rejects|repository|required|requirements-source|requires|resolves|retry|returns|s|safe|satisfies|schedule|seconds|service|set|sets|sourced-from|spi|state|states|status|step|string|suspend|symmetric|synced-via|synchronous-query|temporal|then|time|trigger|triggered-by|true|type|unique|unsafe|upstream|uuid|value|void|w|weeks|when|where|y|years)\\b"
    },
    {
      "name": "string.quoted.double.specy-domain",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.specy-domain"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.specy-domain"
        },
        {
          "begin": "#",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.specy-domain"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.specy-domain"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.specy-domain",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
