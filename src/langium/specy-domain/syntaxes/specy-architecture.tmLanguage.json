{
  "name": "specy-architecture",
  "scopeName": "source.specy-architecture",
  "fileTypes": [
    ".arch"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.specy-architecture",
      "match": "\\b(ACL|CS|Conformist|OHS|Partnership|PublishedLanguage|SharedKernel|architecture|area|as|async|automated|binary|boolean|boundedContext|carries|channel|component|concerns|connect|consumes|container|context|critical|criticality|date|datetime|decimal|dedicated|degraded|dependency|deploy|detailed-in|domain|domain-source|double|duration|enum|environment|event|exception|externalSystem|false|flow|from|handles|hotspot|import|instant|instantiates|int|integer|interface|list|long|manual|map|masters|meta|module|node|null|on|oneway|optional|organization|over|person|phase|provider|provides|publishes|realizes|region|replicas|required|requirements-source|requires|resource|returns|safe|satisfies|set|shared|stores|streaming|string|struct|subscribes|sync|system|technology|tenancy|throws|time|to|tolerant|true|type|typedef|union|used-by|uuid|value|void|zone)\\b"
    },
    {
      "name": "string.quoted.double.specy-architecture",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#string-character-escape"
        }
      ]
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.specy-architecture"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.specy-architecture"
        },
        {
          "begin": "#",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.specy-architecture"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.specy-architecture"
        }
      ]
    },
    "string-character-escape": {
      "name": "constant.character.escape.specy-architecture",
      "match": "\\\\(x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    }
  }
}
