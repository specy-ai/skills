{
  "name": "specy-domain-langium",
  "version": "1.8.0",
  "description": "Langium-based parsers, format converters and LSP server for the Specy DSLs: .domain, .prd, .sysreq, .arch and .synth",
  "type": "module",
  "main": "out/language/specy-domain-module.js",
  "bin": {
    "specy": "out/cli/specy.js",
    "specy-domain": "out/cli/index.js",
    "specy-synth": "out/cli/synth.js"
  },
  "scripts": {
    "langium:generate": "langium generate",
    "build": "npm run langium:generate && npm run schemas && tsc && npm run build:browser",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:browser": "node scripts/build-browser.mjs",
    "schemas": "node scripts/embed-schemas.mjs",
    "pretest": "npm run schemas"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^12.1.0",
    "langium": "^3.3.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "langium-cli": "^3.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
