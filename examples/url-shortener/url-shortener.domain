organization Sniplink :: "Sniplink — a URL shortener with auto-channel analytics" {

  requirements-source "url-shortener.sysreq"

  // ═══════════════════════════════════════════════════════════════════════
  // MODULE MAP
  // ═══════════════════════════════════════════════════════════════════════
  //
  // LinkShortening        -- OHS -->  Redirect              (published short links consumed by redirect)
  // LinkShortening        -- OHS -->  AutoChannelAnalytics  (link created events feed analytics)
  // LinkShortening        -- OHS -->  BookmarkCollection    (link created events feed bookmark collection)
  // LinkSafetyScanning    -- OHS -->  LinkShortening        (safety scan results consumed before link creation)
  // LinkSafetyScanning    -- OHS -->  Redirect              (safety status checked on redirect)
  // Redirect              -- OHS -->  AutoChannelAnalytics  (click events feed analytics)
  // BookmarkCollection    -- SK  --   TeamWorkspaces        (shared collections bridge personal and team)
  // CustomDomains         -- C/S -->  LinkShortening        (custom domains used during link creation)
  // ApiAccess             -- ACL -->  LinkShortening        (API translates HTTP into domain commands)
  // ApiAccess             -- ACL -->  AutoChannelAnalytics  (API translates HTTP into analytics queries)

  context UrlShortener (urlShortener) :: "The single bounded context of the Sniplink product" {
    requirements-source "url-shortener.sysreq"

    // ═══════════════════════════════════════════════════════════════════════
    // MODULE: Link Shortening  (was: module "Link Shortening" > "Link Management")
    // ═══════════════════════════════════════════════════════════════════════

    module LinkShortening :: "Creating, deactivating and deleting short links" {
      requires { NotificationInterface }
      depends on {
        CustomDomains          // CustomDomainId on ShortLink
        LinkSafetyScanning     // SafetyScan must complete before shortening
      }

      // --- Enums ---

      enum SafetyStatus :: "Whether a destination URL is safe, unsafe, or pending scan" {
        safe
        unsafe
        pending
      }

      enum LinkStatus :: "The lifecycle status of a short link" {
        active
        deactivated
        deleted
      }

      // --- Value Types ---

      value Slug :: "A URL-safe identifier that forms the path segment of a short link" {
        satisfies [REQ-LNK-004, REQ-LNK-005]
        fields {
          value : string
        }
        invariants {
          alphanumericAndHyphens :: "A slug must contain only alphanumeric characters and hyphens" {
            value matches [a-zA-Z0-9-]+
            enforcement rejection
          }
          slugMaxLength :: "A slug must not exceed 30 characters" {
            value.length <= 30
            enforcement rejection
          }
        }
      }

      value ShortUrl :: "The complete short URL combining domain and slug" {
        fields {
          // NOTE: renamed from `domain` — `domain` is a reserved keyword (domain service).
          domainName : string
          slug : Slug
        }
      }

      value DestinationUrl :: "The original long URL that the short link redirects to" {
        fields {
          url : string
        }
      }

      value SafetyScanResult :: "The outcome of a safety scan on a destination URL" {
        fields {
          status : SafetyStatus
          scannedAt : datetime
        }
      }

      value SlugAvailability {
        satisfies [REQ-LNK-006, REQ-LNK-007]
        fields {
          slug : Slug
          available : boolean
          suggestedAlternative : Slug optional
        }
      }

      // --- Entities ---

      entity ShortLink :: "A shortened URL that redirects to a destination, owned by a publisher" {
        satisfies [REQ-LNK-001, REQ-LNK-003, REQ-LNK-008]
        identity id : ShortLinkId
        fields {
          slug : Slug
          shortUrl : ShortUrl
          destinationUrl : DestinationUrl
          publisherId : PublisherId
          customDomainId : CustomDomainId optional
          safetyScanResult : SafetyScanResult
          status : LinkStatus
          createdAt : datetime
          deactivatedAt : datetime optional
        }

        operations {
          "shorten url" on ShortenUrl :: "Create a new short link from a destination URL" {
            satisfies [REQ-LNK-001, REQ-LNK-008]
            unsafe
            precondition destinationMustBeSafe {
              safetyScanResult.status = SafetyStatus.safe
            } rejects "Cannot shorten a URL that has not passed safety scanning"
            emits LinkShortened
            emits LinkShorteningFailed
          }

          "deactivate link" on DeactivateLink :: "Deactivate a short link" {
            satisfies [REQ-SAF-008]
            unsafe
            precondition linkMustBeActive {
              status = LinkStatus.active
            } rejects "Only active links can be deactivated"
            emits LinkDeactivated
          }

          "delete link" on DeleteLink :: "Permanently delete a short link" {
            unsafe
            emits LinkDeleted
          }

          reactivateLink(safetyScanResult: SafetyScanResult) : ShortLink :: "Reactivate a previously deactivated link" {
            unsafe
            precondition linkMustBeDeactivated {
              status = LinkStatus.deactivated
            } rejects "Only deactivated links can be reactivated"
            precondition mustBeSafe {
              safetyScanResult.status = SafetyStatus.safe
            } rejects "Cannot reactivate a link that is not safe"
            emits LinkReactivated
          }

          updateSafetyStatus(safetyScanResult: SafetyScanResult) : ShortLink :: "Record the outcome of a re-scan on the link" {
            satisfies [REQ-SAF-009]
            unsafe
            emits LinkSafetyStatusUpdated
            emits LinkFlaggedAsUnsafe
          }
        }

        states {
          machine ShortLinkLifecycle :: "The lifecycle of a short link" {
            state Active {
              invariants {
                hasSafeScan :: "An active link must have completed safety scanning" {
                  safetyScanResult.status != SafetyStatus.pending
                  enforcement rejection
                }
              }
            }

            state Deactivated {
              invariants {
                hasDeactivationTimestamp :: "A deactivated link must record when it was deactivated" {
                  deactivatedAt is not null
                  enforcement rejection
                }
              }
            }

            final Deleted

            [*] --> Active on "shorten url"
            Active --> Deactivated on "deactivate link"
            Active --> Deleted on "delete link"
            Deactivated --> Active on reactivateLink
            Deactivated --> Deleted on "delete link"
          }
        }
      }

      // --- Repositories ---

      repository ShortLinkRepository for ShortLink {
        store(shortLink: ShortLink)
        getById(id: ShortLinkId) : ShortLink
        findBySlug(slug: Slug) : ShortLink
        findByPublisherId(publisherId: PublisherId) : list<ShortLink>
      }

      // --- Commands ---

      command ShortenUrl :: "Intent to create a new short link from a destination URL" {
        satisfies [REQ-LNK-001, REQ-LNK-003]
        identity correlationId : CommandId
        fields {
          destinationUrl : DestinationUrl
          customSlug : Slug optional
          publisherId : PublisherId
        }
      }

      command DeactivateLink :: "Intent to deactivate a short link" {
        satisfies [REQ-SAF-008]
        identity correlationId : CommandId
        fields {
          shortLinkId : ShortLinkId
          reason : string
        }
      }

      command DeleteLink :: "Intent to permanently delete a short link" {
        identity correlationId : CommandId
        fields {
          shortLinkId : ShortLinkId
        }
      }

      // UNCLEAR: no operation targets this command — the original model never bound it to a
      // handler either. The NotificationService is an adapter, so it cannot carry the handler.
      command NotifyPublisherOfUnsafeLink :: "Intent to send an email notification about an unsafe link" {
        satisfies [REQ-SAF-006]
        identity correlationId : CommandId
        fields {
          shortLinkId : ShortLinkId
          publisherId : PublisherId
        }
      }

      // --- Events ---

      event LinkShortened :: "A new short link was successfully created" {
        satisfies [REQ-LNK-001, REQ-LNK-003]
        about ShortLink
        caused-by ShortenUrl
        fields {
          shortLinkId : ShortLinkId
          slug : Slug
          shortUrl : ShortUrl
          destinationUrl : DestinationUrl
          publisherId : PublisherId
          createdAt : datetime
        }
      }

      error event LinkShorteningFailed :: "A short link creation failed" {
        satisfies [REQ-LNK-001]
        caused-by ShortenUrl
        fields {
          correlationId : CommandId
          destinationUrl : DestinationUrl
          reason : string
        }
      }

      event LinkDeactivated :: "A short link was deactivated by the publisher" {
        satisfies [REQ-SAF-008]
        about ShortLink
        caused-by DeactivateLink
        fields {
          shortLinkId : ShortLinkId
          reason : string
          deactivatedAt : datetime
        }
      }

      event LinkReactivated :: "A previously deactivated short link was reactivated" {
        about ShortLink
        fields {
          shortLinkId : ShortLinkId
          reactivatedAt : datetime
        }
      }

      event LinkDeleted :: "A short link was permanently deleted" {
        about ShortLink
        caused-by DeleteLink
        fields {
          shortLinkId : ShortLinkId
          deletedAt : datetime
        }
      }

      event LinkSafetyStatusUpdated :: "The safety status of a link was updated after a re-scan" {
        about ShortLink
        fields {
          shortLinkId : ShortLinkId
          previousStatus : SafetyStatus
          newStatus : SafetyStatus
          scannedAt : datetime
        }
      }

      event LinkFlaggedAsUnsafe :: "A previously safe link was flagged as unsafe during a re-scan" {
        satisfies [REQ-SAF-006, REQ-SAF-007]
        about ShortLink
        fields {
          shortLinkId : ShortLinkId
          publisherId : PublisherId
          flaggedAt : datetime
        }
      }

      // --- Queries ---

      query CheckSlugAvailability :: "Check if a given slug is available for use" {
        satisfies [REQ-LNK-006]
        reads-from ShortLinkRepository
        fields {
          slug : Slug
        }
        returns SlugAvailability
      }

      // --- Reactions ---

      reaction NotifyPublisherOnUnsafeLink :: "When a link is flagged as unsafe, notify the publisher by email" {
        satisfies [REQ-SAF-006]
        triggered-by LinkFlaggedAsUnsafe
        effects NotifyPublisherOfUnsafeLink
      }

      reaction DeactivateUnsafeLink :: "When a link is flagged as unsafe, automatically deactivate it" {
        triggered-by LinkFlaggedAsUnsafe
        effects DeactivateLink
      }

      // --- Domain Services ---

      domain service SlugGenerationService :: "Generates unique slugs and suggests alternatives when a custom slug is taken" {
        satisfies [REQ-LNK-001, REQ-LNK-007]
        operations {
          generateSlug() : Slug :: "Generate a fresh, unused slug" {
            satisfies [REQ-LNK-001]
            safe
          }

          suggestAlternativeSlug(requestedSlug: Slug) : Slug :: "Suggest an alternative when the requested slug is taken" {
            satisfies [REQ-LNK-007]
            safe
          }
        }
      }

      // --- Interfaces (driven ports) ---

      spi interface NotificationInterface :: "What the domain needs in order to notify a publisher" {
        satisfies [REQ-SAF-006]
        describes NotificationService
        sendUnsafeLinkNotification(publisherId: PublisherId, shortLinkId: ShortLinkId) : boolean
      }

      // --- Infrastructure Services ---

      infrastructure service NotificationService :: "Sends email notifications to publishers" {
        satisfies [REQ-SAF-006]
        described-by NotificationInterface
        operations {
          sendUnsafeLinkNotification(publisherId: PublisherId, shortLinkId: ShortLinkId) : boolean
        }
      }
    }


    // ═══════════════════════════════════════════════════════════════════════
    // MODULE: Link Safety Scanning  (was: "Link Safety Scanning" > "Safety Scanning")
    // ═══════════════════════════════════════════════════════════════════════

    module LinkSafetyScanning :: "Scanning destination URLs for threats and handling consumer reports" {
      requires { ThreatIntelligenceInterface }
      depends on {
        LinkShortening         // ShortLinkId, DeactivateLink (reaction effect)
      }

      // --- Enums ---

      enum ThreatType :: "The category of threat detected" {
        phishing
        malware
        socialEngineering
        unwantedSoftware
        unknown
      }

      enum ScanVerdict :: "The result of a safety scan" {
        safe
        unsafe
        inconclusive
      }

      enum ScanSource :: "What triggered the scan" {
        creation
        periodicRescan
        consumerReport
        publisherRequest
      }

      enum ReportStatus :: "The status of a consumer safety report" {
        submitted
        underReview
        resolved
        dismissed
      }

      // --- Value Types ---

      value SafetyReport :: "A consumer-submitted report about a potentially unsafe link" {
        fields {
          reportId : SafetyReportId
          shortLinkId : ShortLinkId
          reportedBy : string
          reason : string
          reportedAt : datetime
        }
      }

      // --- Entities ---

      entity SafetyScan :: "A safety scan performed on a destination URL" {
        satisfies [REQ-SAF-001, REQ-SAF-009, REQ-SAF-010]
        identity id : SafetyScanId
        fields {
          destinationUrl : string
          shortLinkId : ShortLinkId optional
          verdict : ScanVerdict
          threats : list<ThreatType>
          scannedAt : datetime
          scanSource : ScanSource
          expiresAt : datetime
        }

        operations {
          "scan url" on ScanUrl :: "Scan a destination URL for safety threats" {
            satisfies [REQ-SAF-001]
            unsafe
            emits UrlScanned
            emits UrlScanFailed
          }

          "re-scan url" on RescanUrl :: "Re-scan a previously scanned destination URL" {
            satisfies [REQ-SAF-009]
            unsafe
            emits UrlRescanned
            emits UrlFlaggedAsUnsafe
            emits UrlRescanFailed
          }
        }
      }

      entity ConsumerSafetyReport :: "A report submitted by a consumer about a potentially unsafe link" {
        satisfies [REQ-SAF-011]
        identity id : SafetyReportId
        fields {
          shortLinkId : ShortLinkId
          reporterIdentifier : string
          reason : string
          status : ReportStatus
          reportedAt : datetime
          reviewedAt : datetime optional
        }

        operations {
          "submit safety report" on ReportUnsafeLink :: "A consumer reports a link as potentially unsafe" {
            satisfies [REQ-SAF-011]
            unsafe
            emits SafetyReportSubmitted
          }

          reviewSafetyReport(verdict: ScanVerdict) : ConsumerSafetyReport :: "A moderator reviews a consumer safety report" {
            unsafe
            emits SafetyReportReviewed
          }
        }

        states {
          machine ConsumerSafetyReportLifecycle :: "The lifecycle of a consumer safety report" {
            state Submitted
            state UnderReview
            final Resolved
            final Dismissed

            [*] --> Submitted on "submit safety report"
            Submitted --> UnderReview on "submit safety report"
            UnderReview --> Resolved on reviewSafetyReport
            UnderReview --> Dismissed on reviewSafetyReport
          }
        }
      }

      // --- Repositories ---

      repository SafetyScanRepository for SafetyScan {
        store(safetyScan: SafetyScan)
        getById(id: SafetyScanId) : SafetyScan
        findByShortLinkId(shortLinkId: ShortLinkId) : list<SafetyScan>
      }

      // --- Commands ---

      command ScanUrl :: "Intent to scan a URL for safety threats" {
        satisfies [REQ-SAF-001]
        identity correlationId : CommandId
        fields {
          destinationUrl : string
        }
      }

      command RescanUrl :: "Intent to re-scan a previously scanned URL" {
        satisfies [REQ-SAF-009]
        identity correlationId : CommandId
        fields {
          destinationUrl : string
          shortLinkId : ShortLinkId
        }
      }

      command ReportUnsafeLink :: "Intent to report a link as potentially unsafe" {
        satisfies [REQ-SAF-011]
        identity correlationId : CommandId
        fields {
          shortLinkId : ShortLinkId
          reporterIdentifier : string
          reason : string
        }
      }

      // --- Events ---

      event UrlScanned :: "A URL was scanned for safety" {
        satisfies [REQ-SAF-001]
        about SafetyScan
        caused-by ScanUrl
        fields {
          safetyScanId : SafetyScanId
          destinationUrl : string
          verdict : ScanVerdict
          threats : list<ThreatType>
          scannedAt : datetime
        }
      }

      error event UrlScanFailed :: "A URL safety scan failed due to an error" {
        satisfies [REQ-SAF-001]
        caused-by ScanUrl
        fields {
          correlationId : CommandId
          destinationUrl : string
          reason : string
        }
      }

      event UrlRescanned :: "A URL was re-scanned during periodic safety checks" {
        satisfies [REQ-SAF-009]
        about SafetyScan
        caused-by RescanUrl
        fields {
          safetyScanId : SafetyScanId
          shortLinkId : ShortLinkId
          destinationUrl : string
          verdict : ScanVerdict
          scannedAt : datetime
        }
      }

      event UrlFlaggedAsUnsafe :: "A previously safe URL was found to be unsafe during a re-scan" {
        satisfies [REQ-SAF-003, REQ-SAF-006]
        about SafetyScan
        caused-by RescanUrl
        fields {
          safetyScanId : SafetyScanId
          shortLinkId : ShortLinkId
          destinationUrl : string
          threats : list<ThreatType>
          flaggedAt : datetime
        }
      }

      error event UrlRescanFailed :: "A periodic re-scan of a URL failed" {
        caused-by RescanUrl
        fields {
          correlationId : CommandId
          shortLinkId : ShortLinkId
          destinationUrl : string
          reason : string
        }
      }

      event SafetyReportSubmitted :: "A consumer submitted a safety report about a link" {
        satisfies [REQ-SAF-011]
        about ConsumerSafetyReport
        caused-by ReportUnsafeLink
        fields {
          safetyReportId : SafetyReportId
          shortLinkId : ShortLinkId
          reportedAt : datetime
        }
      }

      event SafetyReportReviewed :: "A consumer safety report was reviewed" {
        about ConsumerSafetyReport
        fields {
          safetyReportId : SafetyReportId
          shortLinkId : ShortLinkId
          verdict : ScanVerdict
          reviewedAt : datetime
        }
      }

      // --- Temporal Events ---

      temporal event PeriodicRescanDue :: "Periodic re-scan of all active destination URLs is due" {
        satisfies [REQ-SAF-009]
        schedule "0 */6 * * *"
        guard { true }
        fields { }
      }

      // --- Reactions ---

      reaction TriggerPriorityReviewOnReport :: "When a consumer reports a link, trigger a priority re-scan" {
        satisfies [REQ-SAF-011]
        triggered-by SafetyReportSubmitted
        effects RescanUrl
      }

      reaction FlagLinkOnUnsafeRescan :: "When a re-scan finds an unsafe URL, propagate the flag to the link module" {
        satisfies [REQ-SAF-006]
        triggered-by UrlFlaggedAsUnsafe
        effects DeactivateLink
      }

      reaction RescanOnSchedule :: "When the periodic re-scan window elapses, re-scan the destination URLs" {
        satisfies [REQ-SAF-009]
        triggered-by PeriodicRescanDue
        effects RescanUrl
      }

      // --- Interfaces (driven ports) ---

      spi interface ThreatIntelligenceInterface :: "What the domain needs from an external safety scanning API" {
        satisfies [REQ-SAF-001, REQ-SAF-010]
        describes ThreatIntelligenceService
        checkUrlSafety(url: string) : ScanVerdict
        checkUrlSafetyWithCacheFallback(url: string) : ScanVerdict :: "Falls back to a cached verdict when the provider is unavailable" {
          satisfies [REQ-NFR-014]
        }
      }

      // --- Infrastructure Services ---

      infrastructure service ThreatIntelligenceService :: "Adapter for external safety scanning APIs (e.g. Google Safe Browsing)" {
        satisfies [REQ-SAF-001, REQ-SAF-010, REQ-NFR-014, REQ-NFR-015]
        described-by ThreatIntelligenceInterface
        operations {
          checkUrlSafety(url: string) : ScanVerdict
          checkUrlSafetyWithCacheFallback(url: string) : ScanVerdict
        }
      }

      // --- Invariants ---

      invariant SafetyScanBeforeShortening :: "Every destination URL must be scanned before a short link is created" {
        satisfies [REQ-LNK-008, REQ-SAF-001]
        on SafetyScan
        must { scannedAt is not null and verdict is not null }
        enforcement rejection
      }
    }


    // ═══════════════════════════════════════════════════════════════════════
    // MODULE: Redirect  (was: "Redirect" > "Click Handling")
    // ═══════════════════════════════════════════════════════════════════════

    module Redirect :: "Resolving a short link, applying safety rules, and recording the click" {
      depends on {
        LinkShortening         // ShortLinkId, SafetyStatus, LinkStatus
        LinkSafetyScanning     // safety status checked on redirect
      }

      // --- Enums ---

      enum ReferralChannel :: "The detected source channel of a click" {
        twitterX
        linkedIn
        facebook
        slack
        email
        reddit
        directUnknown
      }

      enum RedirectOutcome :: "The result of processing a redirect request" {
        redirected
        interstitialShown
        warningPageShown
        deactivatedPageShown
      }

      // --- Value Types ---

      value ClickContext :: "Contextual data captured at click time" {
        fields {
          refererHeader : string optional
          utmSource : string optional
          utmMedium : string optional
          userAgent : string
          ipCountry : string optional
          clickedAt : datetime
        }
      }

      value InterstitialPreference :: "Whether a consumer has opted out of the safety interstitial" {
        satisfies [REQ-SAF-005]
        fields {
          optedOut : boolean
        }
      }

      // --- Entities ---

      entity Click :: "A recorded click on a short link" {
        satisfies [REQ-RED-001, REQ-RED-002]
        identity id : ClickId
        fields {
          shortLinkId : ShortLinkId
          channel : ReferralChannel
          clickContext : ClickContext
          outcome : RedirectOutcome
          clickedAt : datetime
        }

        operations {
          "record click and redirect" on ProcessRedirect :: "Record the click, apply the safety rules, and redirect" {
            satisfies [REQ-RED-001, REQ-RED-002]
            unsafe
            precondition linkExists {
              shortLinkId is not null
            } rejects "The short link does not exist"
            emits ClickRecorded
            emits DeactivatedLinkAccessed
          }
        }
      }

      // --- Repositories ---

      repository ClickRepository for Click {
        store(click: Click)
        getById(id: ClickId) : Click
        findByShortLinkId(shortLinkId: ShortLinkId) : list<Click>
      }

      // --- Commands ---

      command ProcessRedirect :: "Intent to process a click on a short link and redirect" {
        satisfies [REQ-RED-001]
        identity correlationId : CommandId
        fields {
          slug : string
          clickContext : ClickContext
          interstitialPreference : InterstitialPreference
        }
      }

      // --- Events ---

      event ClickRecorded :: "A click on a short link was recorded with channel attribution" {
        satisfies [REQ-RED-001, REQ-RED-002, REQ-ANA-001]
        about Click
        caused-by ProcessRedirect
        fields {
          clickId : ClickId
          shortLinkId : ShortLinkId
          channel : ReferralChannel
          clickedAt : datetime
          outcome : RedirectOutcome
        }
      }

      event DeactivatedLinkAccessed :: "A consumer attempted to access a deactivated link" {
        satisfies [REQ-RED-003]
        caused-by ProcessRedirect
        fields {
          shortLinkId : ShortLinkId
          clickedAt : datetime
        }
      }

      event UnsafeLinkAccessAttempted :: "A consumer attempted to access a link flagged as unsafe" {
        satisfies [REQ-SAF-003]
        fields {
          shortLinkId : ShortLinkId
          clickedAt : datetime
        }
      }

      event ConsumerProceededToUnsafeLink :: "A consumer chose to proceed to a flagged destination at their own risk" {
        satisfies [REQ-SAF-004]
        fields {
          shortLinkId : ShortLinkId
          clickedAt : datetime
        }
      }

      // --- Domain Services ---

      domain service ChannelDetectionService :: "Detects the referral channel from click context using referer headers and UTM parameters" {
        satisfies [REQ-ANA-001, REQ-ANA-002]
        operations {
          detectChannel(clickContext: ClickContext) : ReferralChannel :: "Attribute a click to a referral channel" {
            satisfies [REQ-ANA-001]
            safe
          }
        }
      }

      domain service RedirectOrchestrationService :: "Orchestrates the redirect flow including safety check, interstitial, and warning page" {
        satisfies [REQ-RED-001, REQ-SAF-002, REQ-SAF-003, REQ-SAF-005]
        operations {
          resolveRedirect(slug: string, clickContext: ClickContext, interstitialPreference: InterstitialPreference) : RedirectOutcome :: "Decide what a consumer sees when they follow a short link" {
            satisfies [REQ-RED-001, REQ-SAF-002, REQ-SAF-003]
            safe
          }
        }
      }

      // --- Invariants ---

      invariant AggregateAnalyticsNoPii :: "Click data must not contain personally identifiable information" {
        satisfies [REQ-ANA-008, REQ-NFR-011]
        on Click
        must { clickContext does not contain PII }
        enforcement rejection
      }
    }


    // ═══════════════════════════════════════════════════════════════════════
    // MODULE: Auto-Channel Analytics  (was: "Auto-Channel Analytics" > "Analytics")
    // ═══════════════════════════════════════════════════════════════════════

    module AutoChannelAnalytics :: "Aggregating clicks into per-link and per-channel analytics" {
      depends on {
        Redirect               // ClickRecordedExternal event, ReferralChannel
        LinkShortening         // ShortLinkId
      }

      // --- Value Types ---

      value ChannelClickCount :: "Click count for a single channel" {
        fields {
          channel : ReferralChannel
          clickCount : int
        }
      }

      value ChannelBreakdown :: "Click counts broken down by referral channel" {
        satisfies [REQ-ANA-003]
        fields {
          entries : list<ChannelClickCount>
        }
      }

      value DateRange :: "A time period for filtering analytics" {
        satisfies [REQ-ANA-005]
        fields {
          // NOTE: renamed from `from`/`to` — `from` is a reserved keyword (external event `from`).
          fromDate : date
          toDate : date
        }
        invariants {
          fromBeforeTo :: "Start date must be before or equal to end date" {
            fromDate <= toDate
            enforcement rejection
          }
        }
      }

      value TimeSeriesPoint :: "A single data point in a time series" {
        fields {
          date : date
          clickCount : int
        }
      }

      value TimeSeries :: "Click data points over time" {
        fields {
          dataPoints : list<TimeSeriesPoint>
        }
      }

      value AnalyticsSummary :: "Aggregated analytics for a short link" {
        satisfies [REQ-ANA-003, REQ-ANA-007]
        fields {
          shortLinkId : ShortLinkId
          totalClicks : int
          channelBreakdown : ChannelBreakdown
          timeSeries : TimeSeries
        }
      }

      // --- Entities ---

      entity LinkAnalytics :: "Aggregated click analytics for a single short link" {
        satisfies [REQ-ANA-003, REQ-ANA-004, REQ-ANA-006, REQ-ANA-007]
        identity id : LinkAnalyticsId
        fields {
          shortLinkId : ShortLinkId
          publisherId : PublisherId
          totalClicks : int
          channelBreakdown : ChannelBreakdown
          lastUpdatedAt : datetime
        }

        operations {
          "increment click count" on UpdateAnalytics :: "Fold a newly recorded click into the link's analytics" {
            satisfies [REQ-ANA-004, REQ-ANA-006]
            unsafe
            emits AnalyticsUpdated
          }

          "delete analytics for publisher" on DeletePublisherAnalytics :: "Erase all analytics held for a publisher (GDPR right to erasure)" {
            satisfies [REQ-ANA-009]
            unsafe
            emits PublisherAnalyticsDeleted
          }
        }
      }

      // --- Repositories ---

      repository LinkAnalyticsRepository for LinkAnalytics {
        store(linkAnalytics: LinkAnalytics)
        getById(id: LinkAnalyticsId) : LinkAnalytics
        findByShortLinkId(shortLinkId: ShortLinkId) : LinkAnalytics
        findByPublisherId(publisherId: PublisherId) : list<LinkAnalytics>
      }

      // --- Commands ---

      command UpdateAnalytics :: "Intent to update analytics with a new click event" {
        satisfies [REQ-ANA-004]
        identity correlationId : CommandId
        fields {
          shortLinkId : ShortLinkId
          channel : ReferralChannel
          clickedAt : datetime
        }
      }

      command DeletePublisherAnalytics :: "Intent to delete all analytics data for a publisher (GDPR right to erasure)" {
        satisfies [REQ-ANA-009]
        identity correlationId : CommandId
        fields {
          publisherId : PublisherId
        }
      }

      // --- Events ---

      event AnalyticsUpdated :: "Link analytics were updated with a new click" {
        satisfies [REQ-ANA-004, REQ-ANA-006]
        about LinkAnalytics
        caused-by UpdateAnalytics
        fields {
          linkAnalyticsId : LinkAnalyticsId
          shortLinkId : ShortLinkId
          channel : ReferralChannel
          newTotalClicks : int
          updatedAt : datetime
        }
      }

      event PublisherAnalyticsDeleted :: "All analytics data for a publisher was deleted" {
        satisfies [REQ-ANA-009]
        caused-by DeletePublisherAnalytics
        fields {
          publisherId : PublisherId
          deletedAt : datetime
        }
      }

      // --- External Events (consumed from the Redirect module) ---

      external event ClickRecordedExternal :: "A click was recorded in the Redirect module — consumed to update analytics" {
        satisfies [REQ-ANA-001]
        from Redirect
        fields {
          correlationId : ClickId
          shortLinkId : ShortLinkId
          channel : ReferralChannel
          clickedAt : datetime
        }
      }

      // --- Queries ---

      query GetLinkAnalytics :: "Retrieve analytics for a specific short link" {
        satisfies [REQ-ANA-003]
        reads-from LinkAnalyticsRepository
        fields {
          shortLinkId : ShortLinkId
          dateRange : DateRange optional
        }
        returns AnalyticsSummary
      }

      query GetPublisherAnalyticsSummary :: "Retrieve aggregated analytics across all links for a publisher" {
        satisfies [REQ-ANA-007]
        reads-from LinkAnalyticsRepository
        fields {
          publisherId : PublisherId
          dateRange : DateRange optional
        }
        returns list<AnalyticsSummary>
      }

      // --- Reactions ---

      reaction UpdateAnalyticsOnClick :: "When a click is recorded in the redirect module, update analytics" {
        satisfies [REQ-ANA-004]
        triggered-by ClickRecordedExternal
        effects UpdateAnalytics
      }

      // --- Invariants ---

      // UNCLEAR: the original predicate was prose ("no field contains PII"). The expression
      // language cannot quantify over an entity's own fields, so this checks the aggregated
      // breakdown only — the field most at risk of carrying consumer-level data.
      invariant NoPiiInAnalytics :: "Analytics data must never contain personally identifiable information" {
        satisfies [REQ-ANA-008, REQ-NFR-011]
        on LinkAnalytics
        must { channelBreakdown does not contain PII }
        enforcement rejection
      }

      invariant AnalyticsRetention :: "Analytics data must be retained for at least 24 months" {
        satisfies [REQ-NFR-019]
        on LinkAnalytics
        must { retentionPeriod >= 24 months }
        enforcement alert
      }
    }


    // ═══════════════════════════════════════════════════════════════════════
    // MODULE: Bookmark Collection  (was: "Bookmark Collection" > "Collection Management")
    // ═══════════════════════════════════════════════════════════════════════

    module BookmarkCollection :: "Saving shortened links as enriched, searchable bookmarks" {
      requires { MetadataExtractionInterface SearchIndexInterface }
      depends on {
        LinkShortening         // LinkShortenedExternal event, ShortLinkId
      }

      // --- Value Types ---

      value PageMetadata :: "Metadata extracted from the destination page" {
        satisfies [REQ-BMK-002]
        fields {
          title : string optional
          description : string optional
          thumbnailUrl : string optional
        }
      }

      value Tag :: "A label used to categorize bookmarks" {
        satisfies [REQ-BMK-006]
        fields {
          name : string
        }
      }

      // --- Entities ---

      entity Bookmark :: "A saved link in the publisher's collection with enriched metadata" {
        satisfies [REQ-BMK-001, REQ-BMK-002, REQ-BMK-003]
        identity id : BookmarkId
        fields {
          shortLinkId : ShortLinkId
          publisherId : PublisherId
          destinationUrl : string
          shortUrl : string
          metadata : PageMetadata
          tags : list<Tag>
          folderId : FolderId optional
          createdAt : datetime
          updatedAt : datetime optional
        }

        operations {
          "create bookmark" on CreateBookmark :: "Save a shortened link as a bookmark with enriched metadata" {
            satisfies [REQ-BMK-001, REQ-BMK-002, REQ-BMK-003]
            unsafe
            emits BookmarkCreated
          }

          "add tag" on AddTagToBookmark :: "Add a tag to a bookmark" {
            satisfies [REQ-BMK-006]
            unsafe
            emits TagAdded
          }

          "remove tag" on RemoveTagFromBookmark :: "Remove a tag from a bookmark" {
            satisfies [REQ-BMK-006]
            unsafe
            emits TagRemoved
          }

          "move to folder" on MoveBookmarkToFolder :: "Move a bookmark into a folder" {
            satisfies [REQ-BMK-007]
            unsafe
            emits BookmarkMovedToFolder
          }
        }
      }

      entity Folder :: "A container for organizing bookmarks" {
        satisfies [REQ-BMK-007]
        identity id : FolderId
        fields {
          publisherId : PublisherId
          name : string
          parentFolderId : FolderId optional
          createdAt : datetime
        }

        operations {
          "create folder" on CreateFolder :: "Create a new folder" {
            satisfies [REQ-BMK-007]
            unsafe
            emits FolderCreated
          }

          renameFolder(name: string) : Folder :: "Rename a folder" {
            unsafe
            emits FolderRenamed
          }

          deleteFolder() : Folder :: "Delete a folder" {
            unsafe
            emits FolderDeleted
          }
        }
      }

      // --- Repositories ---

      repository BookmarkRepository for Bookmark {
        store(bookmark: Bookmark)
        getById(id: BookmarkId) : Bookmark
        findByPublisherId(publisherId: PublisherId) : list<Bookmark>
        findByFolderId(folderId: FolderId) : list<Bookmark>
      }

      repository FolderRepository for Folder {
        store(folder: Folder)
        getById(id: FolderId) : Folder
        findByPublisherId(publisherId: PublisherId) : list<Folder>
      }

      // --- Commands ---

      command CreateBookmark :: "Intent to save a shortened link as a bookmark" {
        satisfies [REQ-BMK-001]
        identity correlationId : CommandId
        fields {
          shortLinkId : ShortLinkId
          publisherId : PublisherId
          destinationUrl : string
          shortUrl : string
        }
      }

      command AddTagToBookmark :: "Intent to add a tag to a bookmark" {
        satisfies [REQ-BMK-006]
        identity correlationId : CommandId
        fields {
          bookmarkId : BookmarkId
          tag : Tag
        }
      }

      command RemoveTagFromBookmark :: "Intent to remove a tag from a bookmark" {
        satisfies [REQ-BMK-006]
        identity correlationId : CommandId
        fields {
          bookmarkId : BookmarkId
          tag : Tag
        }
      }

      command MoveBookmarkToFolder :: "Intent to move a bookmark into a folder" {
        satisfies [REQ-BMK-007]
        identity correlationId : CommandId
        fields {
          bookmarkId : BookmarkId
          folderId : FolderId
        }
      }

      command CreateFolder :: "Intent to create a new folder" {
        satisfies [REQ-BMK-007]
        identity correlationId : CommandId
        fields {
          publisherId : PublisherId
          name : string
          parentFolderId : FolderId optional
        }
      }

      // --- Events ---

      event BookmarkCreated :: "A new bookmark was created from a shortened link" {
        satisfies [REQ-BMK-001]
        about Bookmark
        caused-by CreateBookmark
        fields {
          bookmarkId : BookmarkId
          shortLinkId : ShortLinkId
          publisherId : PublisherId
          destinationUrl : string
          createdAt : datetime
        }
      }

      event TagAdded :: "A tag was added to a bookmark" {
        satisfies [REQ-BMK-006]
        about Bookmark
        caused-by AddTagToBookmark
        fields {
          bookmarkId : BookmarkId
          tag : Tag
        }
      }

      event TagRemoved :: "A tag was removed from a bookmark" {
        satisfies [REQ-BMK-006]
        about Bookmark
        caused-by RemoveTagFromBookmark
        fields {
          bookmarkId : BookmarkId
          tag : Tag
        }
      }

      event BookmarkMovedToFolder :: "A bookmark was moved to a folder" {
        satisfies [REQ-BMK-007]
        about Bookmark
        caused-by MoveBookmarkToFolder
        fields {
          bookmarkId : BookmarkId
          folderId : FolderId
        }
      }

      event FolderCreated :: "A new folder was created" {
        satisfies [REQ-BMK-007]
        about Folder
        caused-by CreateFolder
        fields {
          folderId : FolderId
          publisherId : PublisherId
          name : string
        }
      }

      event FolderRenamed :: "A folder was renamed" {
        about Folder
        fields {
          folderId : FolderId
          newName : string
        }
      }

      event FolderDeleted :: "A folder was deleted" {
        about Folder
        fields {
          folderId : FolderId
        }
      }

      // --- External Events (consumed from the Link Shortening module) ---

      external event LinkShortenedExternal :: "A link was shortened in the Link Shortening module — consumed to create a bookmark" {
        satisfies [REQ-BMK-001]
        from LinkShortening
        fields {
          correlationId : ShortLinkId
          shortLinkId : ShortLinkId
          destinationUrl : string
          shortUrl : string
          publisherId : PublisherId
        }
      }

      // --- Queries ---

      query SearchBookmarks :: "Full-text search across bookmarks" {
        satisfies [REQ-BMK-004, REQ-BMK-005]
        reads-from BookmarkRepository
        fields {
          publisherId : PublisherId
          queryText : string
          tags : list<Tag> optional
          folderId : FolderId optional
        }
        returns list<Bookmark>
      }

      query GetBookmarksByFolder :: "Retrieve all bookmarks in a folder" {
        satisfies [REQ-BMK-007]
        reads-from BookmarkRepository
        fields {
          folderId : FolderId
        }
        returns list<Bookmark>
      }

      query GetBookmarksByTag :: "Retrieve bookmarks filtered by tag" {
        satisfies [REQ-BMK-006]
        reads-from BookmarkRepository
        fields {
          publisherId : PublisherId
          tag : Tag
        }
        returns list<Bookmark>
      }

      // --- Reactions ---

      reaction CreateBookmarkOnLinkShortened :: "When a link is shortened, automatically create a bookmark" {
        satisfies [REQ-BMK-001]
        triggered-by LinkShortenedExternal
        effects CreateBookmark
      }

      // --- Interfaces (driven ports) ---

      spi interface MetadataExtractionInterface :: "What the domain needs in order to enrich a bookmark" {
        satisfies [REQ-BMK-002, REQ-BMK-003]
        describes MetadataExtractionService
        extractPageMetadata(url: string) : PageMetadata :: "Fetch title, description and Open Graph image" {
          satisfies [REQ-BMK-002]
        }
        generatePreviewThumbnail(openGraphImageUrl: string) : string :: "Produce a preview thumbnail URL" {
          satisfies [REQ-BMK-003]
        }
      }

      spi interface SearchIndexInterface :: "What the domain needs in order to search bookmarks" {
        satisfies [REQ-BMK-004, REQ-BMK-005]
        describes SearchIndexService
        indexBookmark(bookmark: Bookmark) : boolean
        search(queryText: string, publisherId: PublisherId) : list<BookmarkId> :: "Full-text search over the index" {
          satisfies [REQ-BMK-004]
        }
      }

      // --- Infrastructure Services ---

      infrastructure service MetadataExtractionService :: "Fetches page metadata and Open Graph images from destination URLs" {
        satisfies [REQ-BMK-002, REQ-BMK-003]
        described-by MetadataExtractionInterface
        operations {
          extractPageMetadata(url: string) : PageMetadata
          generatePreviewThumbnail(openGraphImageUrl: string) : string
        }
      }

      infrastructure service SearchIndexService :: "Full-text search index for bookmarks" {
        satisfies [REQ-BMK-004, REQ-BMK-005]
        described-by SearchIndexInterface
        operations {
          indexBookmark(bookmark: Bookmark) : boolean
          search(queryText: string, publisherId: PublisherId) : list<BookmarkId>
        }
      }
    }


    // ═══════════════════════════════════════════════════════════════════════
    // MODULE: Custom Domains  (was: "Custom Domains" > "Domain Management")
    // ═══════════════════════════════════════════════════════════════════════

    module CustomDomains :: "Configuring, verifying and securing a publisher's branded domain" {
      requires { DnsVerificationInterface SslCertificateInterface }

      // --- Enums ---

      enum VerificationStatus :: "The status of domain DNS verification" {
        pending
        verified
        failed
      }

      enum SslStatus :: "The status of SSL certificate provisioning" {
        pending
        provisioned
        expired
        failed
      }

      // --- Value Types ---

      value DomainName :: "A custom domain name (e.g., go.acme.com)" {
        fields {
          value : string
        }
      }

      value DnsRecord :: "The CNAME DNS record required for domain setup" {
        satisfies [REQ-DOM-001]
        fields {
          recordType : string
          name : string
          target : string
        }
      }

      // --- Entities ---

      entity CustomDomain :: "A publisher's custom domain configured for branded short links" {
        satisfies [REQ-DOM-001, REQ-DOM-002, REQ-DOM-003, REQ-DOM-004]
        identity id : CustomDomainId
        fields {
          publisherId : PublisherId
          domainName : DomainName
          requiredDnsRecord : DnsRecord
          verificationStatus : VerificationStatus
          sslStatus : SslStatus
          createdAt : datetime
          verifiedAt : datetime optional
          sslProvisionedAt : datetime optional
        }

        operations {
          "initiate domain setup" on InitiateDomainSetup :: "Start the setup of a custom domain" {
            satisfies [REQ-DOM-001]
            unsafe
            emits DomainSetupInitiated
          }

          "verify domain" on VerifyDomain :: "Check that the required CNAME record is in place" {
            satisfies [REQ-DOM-002]
            unsafe
            emits DomainVerified
            emits DomainVerificationFailed
          }

          "provision ssl" on ProvisionSsl :: "Provision an SSL certificate for the verified domain" {
            satisfies [REQ-DOM-003]
            unsafe
            precondition domainMustBeVerified {
              verificationStatus = VerificationStatus.verified
            } rejects "SSL can only be provisioned for verified domains"
            emits SslProvisioned
            emits SslProvisioningFailed
          }

          deactivateDomain() : CustomDomain :: "Deactivate a custom domain" {
            unsafe
            emits DomainDeactivated
          }
        }

        states {
          machine CustomDomainLifecycle :: "The lifecycle of a custom domain" {
            state PendingVerification {
              invariants {
                hasDnsRecord :: "A pending domain must have a required DNS record defined" {
                  requiredDnsRecord is not null
                  enforcement rejection
                }
              }
            }

            state Verified {
              invariants {
                hasVerificationTimestamp :: "A verified domain must record when verification completed" {
                  verifiedAt is not null
                  enforcement rejection
                }
              }
            }

            state SslProvisioned {
              invariants {
                hasSslTimestamp :: "An SSL-provisioned domain must record when the certificate was provisioned" {
                  sslProvisionedAt is not null
                  enforcement rejection
                }
              }
            }

            state Active

            final Deactivated

            [*] --> PendingVerification on "initiate domain setup"
            PendingVerification --> Verified on "verify domain"
            PendingVerification --> PendingVerification on "verify domain"
            Verified --> SslProvisioned on "provision ssl"
            SslProvisioned --> Active on "provision ssl"
            Active --> Deactivated on deactivateDomain
          }
        }
      }

      // --- Repositories ---

      repository CustomDomainRepository for CustomDomain {
        store(customDomain: CustomDomain)
        getById(id: CustomDomainId) : CustomDomain
        findByPublisherId(publisherId: PublisherId) : list<CustomDomain>
      }

      // --- Commands ---

      command InitiateDomainSetup :: "Intent to set up a custom domain" {
        satisfies [REQ-DOM-001]
        identity correlationId : CommandId
        fields {
          publisherId : PublisherId
          domainName : DomainName
        }
      }

      command VerifyDomain :: "Intent to verify a custom domain's DNS configuration" {
        satisfies [REQ-DOM-002]
        identity correlationId : CommandId
        fields {
          customDomainId : CustomDomainId
        }
      }

      command ProvisionSsl :: "Intent to provision an SSL certificate for a verified domain" {
        satisfies [REQ-DOM-003]
        identity correlationId : CommandId
        fields {
          customDomainId : CustomDomainId
        }
      }

      // --- Events ---

      event DomainSetupInitiated :: "A custom domain setup was initiated" {
        satisfies [REQ-DOM-001]
        about CustomDomain
        caused-by InitiateDomainSetup
        fields {
          customDomainId : CustomDomainId
          publisherId : PublisherId
          domainName : DomainName
          requiredDnsRecord : DnsRecord
          initiatedAt : datetime
        }
      }

      event DomainVerified :: "A custom domain was successfully verified" {
        satisfies [REQ-DOM-002]
        about CustomDomain
        caused-by VerifyDomain
        fields {
          customDomainId : CustomDomainId
          verifiedAt : datetime
        }
      }

      error event DomainVerificationFailed :: "Domain verification failed — DNS record not found or incorrect" {
        satisfies [REQ-DOM-002]
        about CustomDomain
        caused-by VerifyDomain
        fields {
          customDomainId : CustomDomainId
          reason : string
        }
      }

      event SslProvisioned :: "SSL certificate was automatically provisioned for a custom domain" {
        satisfies [REQ-DOM-003]
        about CustomDomain
        caused-by ProvisionSsl
        fields {
          customDomainId : CustomDomainId
          provisionedAt : datetime
        }
      }

      error event SslProvisioningFailed :: "SSL certificate provisioning failed" {
        satisfies [REQ-DOM-003]
        about CustomDomain
        caused-by ProvisionSsl
        fields {
          customDomainId : CustomDomainId
          reason : string
        }
      }

      event DomainDeactivated :: "A custom domain was deactivated" {
        about CustomDomain
        fields {
          customDomainId : CustomDomainId
          deactivatedAt : datetime
        }
      }

      // --- Reactions ---

      reaction ProvisionSslAfterVerification :: "When a domain is verified, automatically provision SSL" {
        satisfies [REQ-DOM-003]
        triggered-by DomainVerified
        effects ProvisionSsl
      }

      // --- Interfaces (driven ports) ---

      spi interface DnsVerificationInterface :: "What the domain needs in order to check a CNAME record" {
        satisfies [REQ-DOM-002]
        describes DnsVerificationService
        checkCnameRecord(domainName: string, expectedTarget: string) : boolean
      }

      spi interface SslCertificateInterface :: "What the domain needs in order to obtain and track a certificate" {
        satisfies [REQ-DOM-003]
        describes SslCertificateService
        provisionCertificate(domainName: string) : boolean
        checkCertificateStatus(domainName: string) : SslStatus
      }

      // --- Infrastructure Services ---

      infrastructure service DnsVerificationService :: "Verifies DNS CNAME records for custom domains" {
        satisfies [REQ-DOM-002]
        described-by DnsVerificationInterface
        operations {
          checkCnameRecord(domainName: string, expectedTarget: string) : boolean
        }
      }

      infrastructure service SslCertificateService :: "Provisions and manages SSL certificates for custom domains" {
        satisfies [REQ-DOM-003]
        described-by SslCertificateInterface
        operations {
          provisionCertificate(domainName: string) : boolean
          checkCertificateStatus(domainName: string) : SslStatus
        }
      }
    }


    // ═══════════════════════════════════════════════════════════════════════
    // MODULE: Team Workspaces  (was: "Team Workspaces" > "Workspace Management")
    // ═══════════════════════════════════════════════════════════════════════

    module TeamWorkspaces :: "Shared workspaces, membership and team-level analytics" {
      requires { InvitationEmailInterface CsvExportInterface }
      depends on {
        LinkShortening         // ShortLinkId
        AutoChannelAnalytics   // ChannelBreakdown, DateRange for team analytics
        BookmarkCollection     // shared collections bridge (Shared Kernel)
      }

      // --- Enums ---

      enum MemberRole :: "The role of a member within a workspace" {
        lead
        member
      }

      enum TrialStatus :: "The status of a workspace's free trial" {
        satisfies [REQ-TEM-011]
        active
        expired
        converted
      }

      enum InvitationStatus :: "The status of a workspace invitation" {
        pending
        accepted
        revoked
      }

      // --- Value Types ---

      value LinkPerformance :: "Performance data for a single link in team analytics" {
        fields {
          shortLinkId : ShortLinkId
          totalClicks : int
          contributorId : PublisherId
        }
      }

      value TeamAnalyticsSummary :: "Aggregated analytics for a team workspace" {
        satisfies [REQ-TEM-005]
        fields {
          totalClicks : int
          topPerformingLinks : list<LinkPerformance>
          channelBreakdown : ChannelBreakdown
        }
      }

      // --- Aggregates ---

      aggregate Workspace :: "A shared space for team collaboration on links and analytics" {
        satisfies [REQ-TEM-001, REQ-TEM-011]
        identity id : WorkspaceId
        fields {
          name : string
          createdBy : PublisherId
          trialStatus : TrialStatus
          trialStartedAt : datetime
          trialEndsAt : datetime
          createdAt : datetime
        }
        entities { WorkspaceMember WorkspaceInvitation }

        operations {
          "create workspace" on CreateWorkspace :: "Create a new team workspace with a 14-day trial" {
            satisfies [REQ-TEM-001, REQ-TEM-011]
            unsafe
            postcondition trialStarted {
              trialStatus = TrialStatus.active and trialEndsAt = createdAt + 14 days
            }
            emits WorkspaceCreated
          }
        }

        states {
          machine WorkspaceTrialLifecycle :: "The trial lifecycle of a workspace" {
            state TrialActive {
              invariants {
                withinTrialPeriod :: "Trial must be within the 14-day trial period" {
                  now() <= trialEndsAt
                  enforcement rejection
                }
              }
            }

            state TrialExpired

            final Converted

            // UNCLEAR: "trial expired" and "convert to paid" name no operation in the model —
            // the original state machine referenced them without defining them.
            [*] --> TrialActive on "create workspace"
            TrialActive --> TrialExpired on "trial expired"
            TrialActive --> Converted on "convert to paid"
            TrialExpired --> Converted on "convert to paid"
          }
        }
      }

      aggregate SharedCollection :: "A collection of links shared across team workspace members" {
        satisfies [REQ-TEM-008, REQ-TEM-009]
        identity id : SharedCollectionId
        fields {
          workspaceId : WorkspaceId
          name : string
          createdBy : PublisherId
          createdAt : datetime
        }
        entities { SharedLink }

        operations {
          createSharedCollection(workspaceId: WorkspaceId, name: string, createdBy: PublisherId) : SharedCollection :: "Create a shared collection in a workspace" {
            satisfies [REQ-TEM-008]
            unsafe
            emits SharedCollectionCreated
          }
        }
      }

      // --- Entities ---

      entity WorkspaceMember :: "A member of a team workspace" {
        satisfies [REQ-TEM-002, REQ-TEM-004, REQ-TEM-010]
        identity id : WorkspaceMemberId
        fields {
          workspaceId : WorkspaceId
          publisherId : PublisherId
          role : MemberRole
          joinedAt : datetime
          removedAt : datetime optional
        }

        operations {
          "add member" on AddMemberToWorkspace :: "Add a publisher to a workspace" {
            satisfies [REQ-TEM-002, REQ-TEM-003]
            unsafe
            emits MemberJoined
          }

          "remove member" on RemoveMember :: "Remove a member from a workspace" {
            satisfies [REQ-TEM-004]
            unsafe
            emits MemberRemoved
          }
        }
      }

      entity WorkspaceInvitation :: "An invitation sent to a potential workspace member" {
        satisfies [REQ-TEM-002]
        identity id : InvitationId
        fields {
          workspaceId : WorkspaceId
          email : string
          status : InvitationStatus
          invitedBy : PublisherId
          sentAt : datetime
          acceptedAt : datetime optional
        }

        operations {
          "send invitation" on InviteMember :: "Send a workspace invitation by email" {
            satisfies [REQ-TEM-002]
            unsafe
            emits InvitationSent
          }

          acceptInvitation(publisherId: PublisherId) : WorkspaceInvitation :: "Accept a workspace invitation" {
            satisfies [REQ-TEM-002, REQ-TEM-003]
            unsafe
            emits InvitationAccepted
          }

          revokeInvitation() : WorkspaceInvitation :: "Revoke a pending workspace invitation" {
            unsafe
            emits InvitationRevoked
          }
        }

        states {
          machine InvitationLifecycle :: "The lifecycle of a workspace invitation" {
            state Pending

            final Accepted
            final Revoked

            [*] --> Pending on "send invitation"
            Pending --> Accepted on acceptInvitation
            Pending --> Revoked on revokeInvitation
          }
        }
      }

      entity SharedLink :: "A link saved to a shared collection with contributor attribution" {
        satisfies [REQ-TEM-009, REQ-TEM-010]
        identity id : SharedLinkId
        fields {
          sharedCollectionId : SharedCollectionId
          shortLinkId : ShortLinkId
          contributorId : PublisherId
          sharedAt : datetime
        }

        operations {
          "share link to collection" on ShareLinkToCollection :: "Save a link to a shared collection, attributed to its contributor" {
            satisfies [REQ-TEM-008, REQ-TEM-009, REQ-TEM-010]
            unsafe
            emits LinkSharedToCollection
          }
        }
      }

      // --- Repositories ---

      repository WorkspaceRepository for Workspace {
        store(workspace: Workspace)
        getById(id: WorkspaceId) : Workspace
        findByCreatedBy(createdBy: PublisherId) : list<Workspace>
      }

      repository SharedCollectionRepository for SharedCollection {
        store(sharedCollection: SharedCollection)
        getById(id: SharedCollectionId) : SharedCollection
        findByWorkspaceId(workspaceId: WorkspaceId) : list<SharedCollection>
      }

      // --- Commands ---

      command CreateWorkspace :: "Intent to create a new team workspace" {
        satisfies [REQ-TEM-001]
        identity correlationId : CommandId
        fields {
          name : string
          createdBy : PublisherId
        }
      }

      command InviteMember :: "Intent to invite a member to a workspace by email" {
        satisfies [REQ-TEM-002]
        identity correlationId : CommandId
        fields {
          workspaceId : WorkspaceId
          email : string
          invitedBy : PublisherId
        }
      }

      command AddMemberToWorkspace :: "Intent to add a member to a workspace after invitation acceptance" {
        satisfies [REQ-TEM-003]
        identity correlationId : CommandId
        fields {
          workspaceId : WorkspaceId
          publisherId : PublisherId
          role : MemberRole
        }
      }

      command RemoveMember :: "Intent to remove a member from a workspace" {
        satisfies [REQ-TEM-004]
        identity correlationId : CommandId
        fields {
          workspaceId : WorkspaceId
          memberId : WorkspaceMemberId
        }
      }

      command ShareLinkToCollection :: "Intent to share a link to a shared collection" {
        satisfies [REQ-TEM-008, REQ-TEM-009]
        identity correlationId : CommandId
        fields {
          sharedCollectionId : SharedCollectionId
          shortLinkId : ShortLinkId
          contributorId : PublisherId
        }
      }

      // UNCLEAR: no operation targets this command — the original model bound the CSV export to
      // the CsvExportService adapter only, which cannot carry a command handler.
      command ExportAnalyticsCsv :: "Intent to export team analytics as CSV" {
        satisfies [REQ-TEM-007]
        identity correlationId : CommandId
        fields {
          workspaceId : WorkspaceId
          dateRange : DateRange optional
          memberId : PublisherId optional
          sharedCollectionId : SharedCollectionId optional
        }
      }

      // --- Events ---

      event WorkspaceCreated :: "A new team workspace was created with a 14-day trial" {
        satisfies [REQ-TEM-001, REQ-TEM-011]
        about Workspace
        caused-by CreateWorkspace
        fields {
          workspaceId : WorkspaceId
          name : string
          createdBy : PublisherId
          trialEndsAt : datetime
          createdAt : datetime
        }
      }

      event InvitationSent :: "An invitation email was sent to a potential workspace member" {
        satisfies [REQ-TEM-002]
        about WorkspaceInvitation
        caused-by InviteMember
        fields {
          invitationId : InvitationId
          workspaceId : WorkspaceId
          email : string
          sentAt : datetime
        }
      }

      event InvitationAccepted :: "A workspace invitation was accepted" {
        satisfies [REQ-TEM-002, REQ-TEM-003]
        about WorkspaceInvitation
        fields {
          invitationId : InvitationId
          workspaceId : WorkspaceId
          publisherId : PublisherId
          acceptedAt : datetime
        }
      }

      event InvitationRevoked :: "A workspace invitation was revoked" {
        about WorkspaceInvitation
        fields {
          invitationId : InvitationId
          workspaceId : WorkspaceId
        }
      }

      event MemberJoined :: "A new member joined a workspace" {
        satisfies [REQ-TEM-003]
        about WorkspaceMember
        caused-by AddMemberToWorkspace
        fields {
          workspaceMemberId : WorkspaceMemberId
          workspaceId : WorkspaceId
          publisherId : PublisherId
          joinedAt : datetime
        }
      }

      event MemberRemoved :: "A member was removed from a workspace" {
        satisfies [REQ-TEM-004]
        about WorkspaceMember
        caused-by RemoveMember
        fields {
          workspaceMemberId : WorkspaceMemberId
          workspaceId : WorkspaceId
          removedAt : datetime
        }
      }

      event SharedCollectionCreated :: "A new shared collection was created in a workspace" {
        satisfies [REQ-TEM-008]
        about SharedCollection
        fields {
          sharedCollectionId : SharedCollectionId
          workspaceId : WorkspaceId
          name : string
        }
      }

      event LinkSharedToCollection :: "A link was shared to a team collection with contributor attribution" {
        satisfies [REQ-TEM-009, REQ-TEM-010]
        about SharedLink
        caused-by ShareLinkToCollection
        fields {
          sharedLinkId : SharedLinkId
          sharedCollectionId : SharedCollectionId
          shortLinkId : ShortLinkId
          contributorId : PublisherId
          sharedAt : datetime
        }
      }

      event AnalyticsCsvExported :: "Team analytics were exported as CSV" {
        satisfies [REQ-TEM-007]
        caused-by ExportAnalyticsCsv
        fields {
          workspaceId : WorkspaceId
          exportedAt : datetime
        }
      }

      // --- Temporal Events ---

      temporal event TrialExpired :: "A workspace's 14-day free trial has expired" {
        satisfies [REQ-TEM-011]
        about Workspace
        instant Workspace.trialEndsAt
        guard { Workspace.trialStatus = TrialStatus.active }
        fields {
          workspaceId : WorkspaceId
        }
      }

      // --- Queries ---

      query GetTeamAnalytics :: "Retrieve aggregated analytics across all team links" {
        satisfies [REQ-TEM-005, REQ-TEM-006]
        reads-from WorkspaceRepository
        fields {
          workspaceId : WorkspaceId
          dateRange : DateRange optional
          memberId : PublisherId optional
          sharedCollectionId : SharedCollectionId optional
        }
        returns TeamAnalyticsSummary
      }

      query GetWorkspaceMembers :: "Retrieve all members of a workspace" {
        reads-from WorkspaceRepository
        fields {
          workspaceId : WorkspaceId
        }
        returns list<WorkspaceMember>
      }

      query GetSharedCollections :: "Retrieve all shared collections in a workspace" {
        satisfies [REQ-TEM-003]
        reads-from SharedCollectionRepository
        fields {
          workspaceId : WorkspaceId
        }
        returns list<SharedCollection>
      }

      // --- Reactions ---

      reaction AddMemberOnInvitationAccepted :: "When an invitation is accepted, add the publisher as a workspace member" {
        satisfies [REQ-TEM-002, REQ-TEM-003]
        triggered-by InvitationAccepted
        effects AddMemberToWorkspace
      }

      // --- Interfaces (driven ports) ---

      spi interface InvitationEmailInterface :: "What the domain needs in order to invite someone by email" {
        satisfies [REQ-TEM-002]
        describes InvitationEmailService
        sendInvitationEmail(email: string, workspaceName: string, joinLink: string) : boolean
      }

      spi interface CsvExportInterface :: "What the domain needs in order to render an analytics export" {
        satisfies [REQ-TEM-007]
        describes CsvExportService
        // NOTE: the original returned `Bytes`, which is not a primitive of the grammar;
        // the rendered CSV document is modeled as a string.
        generateCsv(data: TeamAnalyticsSummary) : string
      }

      // --- Infrastructure Services ---

      infrastructure service InvitationEmailService :: "Sends workspace invitation emails" {
        satisfies [REQ-TEM-002]
        described-by InvitationEmailInterface
        operations {
          sendInvitationEmail(email: string, workspaceName: string, joinLink: string) : boolean
        }
      }

      infrastructure service CsvExportService :: "Generates CSV exports of analytics data" {
        satisfies [REQ-TEM-007]
        described-by CsvExportInterface
        operations {
          generateCsv(data: TeamAnalyticsSummary) : string
        }
      }
    }


    // ═══════════════════════════════════════════════════════════════════════
    // MODULE: API Access  (was: "API Access" > "API Gateway")
    // ═══════════════════════════════════════════════════════════════════════

    module ApiAccess :: "Authenticated, rate-limited programmatic access to shortening and analytics" {
      depends on {
        LinkShortening         // ShortenUrl command (API translates HTTP into domain commands)
        AutoChannelAnalytics   // AnalyticsSummary, DateRange (API exposes analytics)
      }

      // --- Value Types ---

      value ApiKey :: "An API key used for authenticating API requests" {
        satisfies [REQ-API-002, REQ-NFR-010]
        fields {
          keyHash : string
          publisherId : PublisherId
          createdAt : datetime
          revokedAt : datetime optional
        }
      }

      value RateLimitStatus :: "The current rate limit status for a publisher" {
        satisfies [REQ-API-003]
        fields {
          requestsRemaining : int
          windowResetAt : datetime
          limitPerMinute : int
        }
      }

      value PaginationParams :: "Pagination parameters for API responses" {
        satisfies [REQ-API-007]
        fields {
          page : int
          pageSize : int
          totalItems : int
          totalPages : int
        }
      }

      value ApiResponse :: "Standardized API response format" {
        satisfies [REQ-API-004]
        fields {
          shortUrl : string
          slug : string
          createdAt : datetime
        }
      }

      // --- Entities ---

      entity ApiClient :: "A publisher's API access configuration with key and rate limit tracking" {
        satisfies [REQ-API-001, REQ-API-002, REQ-API-003]
        identity id : ApiClientId
        fields {
          publisherId : PublisherId
          apiKeyHash : string
          rateLimitPerMinute : int
          requestCountInWindow : int
          windowStartedAt : datetime
          createdAt : datetime
        }

        operations {
          "generate api key" on GenerateApiKey :: "Issue a new API key for a publisher" {
            satisfies [REQ-API-002]
            unsafe
            emits ApiKeyGenerated
          }

          authenticateRequest(apiKeyHash: string) : boolean :: "Authenticate an incoming API request against the stored key hash" {
            satisfies [REQ-API-002]
            unsafe
            emits ApiRequestAuthenticated
            emits ApiAuthenticationFailed
          }

          checkRateLimit() : RateLimitStatus :: "Check whether the publisher is within their rate limit" {
            satisfies [REQ-API-003]
            unsafe
            emits RateLimitExceeded
          }

          recordApiRequest() : ApiClient :: "Record an API request against the current rate-limit window" {
            satisfies [REQ-API-003]
            unsafe
            emits ApiRequestRecorded
          }

          revokeApiKey() : ApiClient :: "Revoke a publisher's API key" {
            unsafe
            emits ApiKeyRevoked
          }
        }
      }

      // --- Repositories ---

      repository ApiClientRepository for ApiClient {
        store(apiClient: ApiClient)
        getById(id: ApiClientId) : ApiClient
        findByPublisherId(publisherId: PublisherId) : ApiClient
      }

      // --- Commands ---

      command GenerateApiKey :: "Intent to generate a new API key for a publisher" {
        satisfies [REQ-API-002]
        identity correlationId : CommandId
        fields {
          publisherId : PublisherId
        }
      }

      // UNCLEAR: no operation targets this command — the original model translated it into a
      // Link Shortening `ShortenUrl` without modeling the translating operation.
      command ShortenUrlViaApi :: "Intent to shorten a URL through the API" {
        satisfies [REQ-API-001]
        identity correlationId : CommandId
        fields {
          apiKeyHash : string
          destinationUrl : string
          customSlug : string optional
        }
      }

      // UNCLEAR: no operation targets this command — the original model translated it into the
      // GetLinkAnalyticsViaApi query without modeling the translating operation.
      command RetrieveAnalyticsViaApi :: "Intent to retrieve link analytics through the API" {
        satisfies [REQ-API-005]
        identity correlationId : CommandId
        fields {
          apiKeyHash : string
          shortLinkId : ShortLinkId
          dateRange : DateRange optional
          pagination : PaginationParams optional
        }
      }

      // --- Events ---

      event ApiKeyGenerated :: "A new API key was generated for a publisher" {
        satisfies [REQ-API-002]
        about ApiClient
        caused-by GenerateApiKey
        fields {
          apiClientId : ApiClientId
          publisherId : PublisherId
          createdAt : datetime
        }
      }

      event ApiKeyRevoked :: "An API key was revoked" {
        about ApiClient
        fields {
          apiClientId : ApiClientId
          revokedAt : datetime
        }
      }

      event ApiRequestAuthenticated :: "An API request was successfully authenticated" {
        satisfies [REQ-API-002]
        about ApiClient
        fields {
          apiClientId : ApiClientId
          authenticatedAt : datetime
        }
      }

      error event ApiAuthenticationFailed :: "An API authentication attempt failed" {
        satisfies [REQ-API-002]
        fields {
          apiKeyHash : string
          reason : string
          failedAt : datetime
        }
      }

      error event RateLimitExceeded :: "A publisher exceeded their API rate limit" {
        satisfies [REQ-API-008]
        about ApiClient
        fields {
          apiClientId : ApiClientId
          publisherId : PublisherId
          retryAfterSeconds : int
          exceededAt : datetime
        }
      }

      event ApiRequestRecorded :: "An API request was recorded for rate limiting" {
        satisfies [REQ-API-003]
        about ApiClient
        fields {
          apiClientId : ApiClientId
          recordedAt : datetime
        }
      }

      // --- Queries ---

      query GetLinkAnalyticsViaApi :: "Retrieve link analytics via the API with date filtering and pagination" {
        satisfies [REQ-API-005, REQ-API-006, REQ-API-007]
        reads-from LinkAnalyticsRepository
        fields {
          apiClientId : ApiClientId
          shortLinkId : ShortLinkId
          dateRange : DateRange optional
          pagination : PaginationParams optional
        }
        returns AnalyticsSummary
      }

      // --- Invariants ---

      invariant RateLimitPerMinute :: "API requests must not exceed the rate limit per minute (100/min)" {
        satisfies [REQ-API-003]
        on ApiClient
        must { requestCountInWindow <= rateLimitPerMinute }
        enforcement rejection
      }

      invariant ApiKeyStoredHashed :: "API keys must be stored using one-way hashing — only the hash is persisted, never the plaintext key" {
        satisfies [REQ-NFR-010]
        on ApiClient
        must { apiKeyHash is not null }
        enforcement rejection
      }
    }


    // ═══════════════════════════════════════════════════════════════════════
    // CROSS-MODULE AGREEMENTS
    // ═══════════════════════════════════════════════════════════════════════

    agreement LinkSafetyConsistency :: "Every active short link must have a corresponding safety scan with a Safe verdict" {
      satisfies [REQ-LNK-008, REQ-SAF-001]
      participants { ShortLink, SafetyScan }
      predicate {
        every link in ShortLinks {
          if link.status = LinkStatus.active {
            exists scan in SafetyScans where scan.shortLinkId = link.id and scan.verdict = ScanVerdict.safe
          }
        }
      }

      reconciliation SafetyScanReconciliation {
        trigger event UrlFlaggedAsUnsafe
        detection query
        compensation { DeactivateLink }
        coordination orchestration
        escalation {
          step deactivationFailed :: "The automatic deactivation of the unsafe link failed" {
            when { true }
            action retry(3)
          }
          step retriesExhausted :: "Retries exhausted — a human must take the link down" {
            when { true }
            action alert "An unsafe short link could not be deactivated automatically"
          }
        }
      }
    }

    agreement BookmarkLinkConsistency :: "Every shortened link must have a corresponding bookmark in the publisher's collection" {
      satisfies [REQ-BMK-001]
      participants { ShortLink, Bookmark }
      predicate {
        every link in ShortLinks {
          exists bookmark in Bookmarks where bookmark.shortLinkId = link.id and bookmark.publisherId = link.publisherId
        }
      }

      reconciliation BookmarkCreationReconciliation {
        trigger event LinkShortened
        detection event-sourced
        compensation { CreateBookmark }
        coordination choreography
        escalation {
          step bookmarkCreationFailed :: "The automatic bookmark creation failed" {
            when { true }
            action retry(3)
          }
          step retriesExhausted :: "Retries exhausted — the publisher's collection is incomplete" {
            when { true }
            action alert "A shortened link could not be bookmarked automatically"
          }
        }
      }
    }

    // UNCLEAR: the original predicate counted the clicks of one link
    // (`totalClicks >= count(Click where shortLinkId)`); the expression language has no
    // filtered count, so this checks only that a click is reflected in a non-empty analytics
    // record for its link. The "within 30 seconds" freshness bound is likewise not expressible.
    agreement AnalyticsClickConsistency :: "Every recorded click must be reflected in the analytics within 30 seconds" {
      satisfies [REQ-ANA-004]
      participants { Click, LinkAnalytics }
      predicate {
        every click in Clicks {
          exists analytics in AllLinkAnalytics where analytics.shortLinkId = click.shortLinkId and analytics.totalClicks > 0
        }
      }

      reconciliation AnalyticsUpdateReconciliation {
        trigger event ClickRecorded
        detection event-sourced
        compensation { UpdateAnalytics }
        coordination choreography
        escalation {
          step analyticsUpdateFailed :: "The analytics update failed" {
            when { true }
            action retry(5)
          }
          step retriesExhausted :: "Retries exhausted — the click is missing from the analytics" {
            when { true }
            action alert "A recorded click could not be folded into the link analytics"
          }
        }
      }
    }

    // UNCLEAR: the original predicate was prose ("no LinkAnalytics, Bookmark or ShortLink
    // references publisherId within 30 days"). Expressed here as: for every deletion request,
    // no analytics record still references the publisher. The 30-day bound and the Bookmark /
    // ShortLink legs are not expressible in the expression language.
    // NOTE: PublisherDeletionRequested, DeletePublisherBookmarks and DeletePublisherLinks are
    // named by the original model but never defined in it.
    agreement GdprRightToErasure :: "When a publisher requests account deletion, all associated data must be erased within 30 days" {
      satisfies [REQ-ANA-009, REQ-NFR-012]
      participants { LinkAnalytics, Bookmark, ShortLink }
      predicate {
        every request in PublisherDeletionRequests {
          not exists analytics in AllLinkAnalytics where analytics.publisherId = request.publisherId
        }
      }

      reconciliation GdprErasureReconciliation {
        trigger event PublisherDeletionRequested
        detection query
        compensation { DeletePublisherAnalytics, DeletePublisherBookmarks, DeletePublisherLinks }
        coordination orchestration
        escalation {
          step deletionIncompleteAfterSevenDays :: "Deletion still incomplete after 7 days" {
            when { true }
            action retry(3)
          }
          step deletionIncompleteAfterTwentyFiveDays :: "Deletion still incomplete after 25 days — the 30-day legal deadline is at risk" {
            when { true }
            action manual "A data protection officer must complete the erasure by hand before the 30-day deadline"
          }
        }
      }
    }
  }
}
