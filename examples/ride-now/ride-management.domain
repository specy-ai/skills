context RideManagement :: "Ride lifecycle — upfront fare, matching, pickup-to-completion, cancellation, safety" {
    requirements-source "ride-management.sysreq"

    enum RideRequestStatus { searching, matched, cancelled }
    enum RideStatus { driverAssigned, driverArrived, inProgress, completed, cancelled }
    enum RideOfferStatus { pending, accepted, declined, timeout, retracted }
    enum CancellationReason {
        riderBeforeAssignment, riderAfterAssignment, noDriverAvailable,
        driverCancelled, driverNoShow, riderNoShow, systemFault
    }
    enum SafetyReportSeverity { low, medium, high, critical }
    enum EmergencyEventType { riderEmergency, driverEmergency }
    enum RideScheduleType { immediate, scheduled }

    // -----------------------------------------------------------------
    // Value types
    // -----------------------------------------------------------------

    value Location {
        fields {
            latitude : decimal
            longitude : decimal
        }
    }

    value Route {
        fields {
            waypoints : list<Location>
            distance : Distance
            duration : Duration
        }
    }

    value FareEstimate :: "Committed fare shown at confirm" {
        satisfies [REQ-RIDE-003, REQ-RIDE-004, REQ-RIDE-005, REQ-RIDE-NFR-002]
        fields {
            amount : Amount
            surgeMultiplier : decimal min(1.0)
            distance : Distance
            duration : Duration
            committedAt : datetime
        }
    }

    value FinalFare {
        satisfies [REQ-RIDE-048]
        fields {
            amount : Amount
            surgeMultiplier : decimal min(1.0)
            actualDistance : Distance
            actualDuration : Duration
            computedAt : datetime
        }
    }

    value CancellationDetail {
        satisfies [REQ-RIDE-060, REQ-RIDE-061, REQ-RIDE-062, REQ-RIDE-NFR-005]
        fields {
            reason : CancellationReason
            cancelledBy : string
            cancelledAt : datetime
            feeCharged : boolean
            feeAmount : Amount optional
        }
    }

    value TripSharingLink {
        satisfies [REQ-RIDE-080]
        fields {
            linkToken : string
            contactName : string
            contactPhone : PhoneNumber
            activatedAt : datetime
            expiresAt : datetime
        }
    }

    value PhoneNumber {
        fields {
            countryCode : string
            number : string
        }
    }

    // The star rating (and optional comment) exchanged at the end of a ride. The
    // previous model typed these `any`, which the grammar has no counterpart for.
    value RideRating :: "A rating given at the end of a ride" {
        fields {
            score : int min(1) max(5)
            comment : string optional
        }
    }

    // Search filters, referenced by the repositories below.
    value RideRequestSearchCriteria :: "Search filter over ride requests" {
        fields {
            riderId : uuid optional
            status : RideRequestStatus optional
        }
    }

    value RideSearchCriteria :: "Search filter over rides" {
        fields {
            riderId : uuid optional
            driverId : uuid optional
            status : RideStatus optional
        }
    }

    // -----------------------------------------------------------------
    // Entities (non-root children of the two aggregates below)
    // -----------------------------------------------------------------

    entity RideOffer :: "Offer of a ride to a single driver" {
        satisfies [REQ-RIDE-021, REQ-RIDE-022, REQ-RIDE-023]
        identity offerId : uuid
        fields {
            rideRequestId : uuid
            driverId : uuid
            status : RideOfferStatus default("pending")
            offeredAt : datetime
            respondedAt : datetime optional
            timeoutSeconds : int default(15)
        }
    }

    entity EmergencyEvent {
        satisfies [REQ-RIDE-081, REQ-RIDE-082, REQ-RIDE-083]
        identity emergencyId : uuid
        fields {
            rideId : uuid
            type : EmergencyEventType
            triggeredBy : uuid
            triggeredAt : datetime
            location : Location
            acknowledgedAt : datetime optional
            resolvedAt : datetime optional
        }
    }

    entity SafetyReport {
        satisfies [REQ-RIDE-085, REQ-RIDE-086]
        identity reportId : uuid
        fields {
            rideId : uuid
            reportedBy : uuid
            severity : SafetyReportSeverity
            description : string maxLength(4000)
            reportedAt : datetime
            withinWindow : boolean
            escalated : boolean default(false)
            escalatedAt : datetime optional
        }
    }

    // -----------------------------------------------------------------
    // Aggregates
    // -----------------------------------------------------------------
    //
    // The previous model paired `entity RideRequest` / `entity Ride` with separate
    // `aggregate ...Aggregate root ... { contains [...] }` declarations. An aggregate
    // now IS its root: `entities { }` lists only the non-root children.

    aggregate RideRequest :: "Rider intent — destination, fare, matching state" {
        satisfies [REQ-RIDE-001, REQ-RIDE-002, REQ-RIDE-003, REQ-RIDE-004, REQ-RIDE-005, REQ-RIDE-006,
                   REQ-RIDE-007, REQ-RIDE-008, REQ-RIDE-009, REQ-RIDE-020, REQ-RIDE-024, REQ-RIDE-025,
                   REQ-RIDE-060, REQ-RIDE-NFR-001, REQ-RIDE-NFR-002]

        identity requestId : uuid
        fields {
            riderId : uuid
            status : RideRequestStatus default("searching")
            scheduleType : RideScheduleType default("immediate")
            scheduledPickupTime : datetime optional
            pickupLocation : Location
            dropoffLocation : Location
            committedFare : FareEstimate
            matchedDriverId : uuid optional
            matchedAt : datetime optional
            cancellation : CancellationDetail optional
            createdAt : datetime
            updatedAt : datetime
        }

        entities { RideOffer }

        operations {
            "Request a ride" on RequestRide {
                satisfies [REQ-RIDE-001, REQ-RIDE-002, REQ-RIDE-003, REQ-RIDE-004, REQ-RIDE-005]
                unsafe

                precondition riderReadyToRide { requestRide.riderReadyToRide = true }
                    rejects "The rider is not ready to ride — their phone is unverified or they have no active payment method"

                precondition committedFareProvided { requestRide.committedFare is defined }
                    rejects "A ride cannot be requested without a fare committed up front"

                precondition paymentMethodValid { requestRide.paymentMethodValid = true }
                    rejects "The rider's payment method is not valid"

                sets RideRequest {
                    riderId = requestRide.riderId
                    pickupLocation = requestRide.pickupLocation
                    dropoffLocation = requestRide.dropoffLocation
                    committedFare = requestRide.committedFare
                    scheduleType = requestRide.scheduleType
                    scheduledPickupTime = requestRide.scheduledPickupTime
                    status = searching
                    createdAt = now()
                    updatedAt = now()
                }
                emits RideRequested {
                    requestId = RideRequest.requestId
                    riderId = RideRequest.riderId
                    pickupLocation = RideRequest.pickupLocation
                    dropoffLocation = RideRequest.dropoffLocation
                    committedFare = RideRequest.committedFare
                    scheduleType = RideRequest.scheduleType
                    requestedAt = RideRequest.createdAt
                }
            }

            "Match driver" on AcceptRideOffer {
                satisfies [REQ-RIDE-021, REQ-RIDE-025]
                unsafe

                precondition stillSearching { RideRequest.status = searching }
                    rejects "This request is no longer searching for a driver"

                sets RideRequest {
                    status = matched
                    matchedDriverId = acceptRideOffer.driverId
                    matchedAt = now()
                }
                emits RideRequestMatched {
                    requestId = RideRequest.requestId
                    driverId = RideRequest.matchedDriverId
                    matchedAt = RideRequest.matchedAt
                }
            }

            "Cancel request before assignment" on CancelRequestByRider {
                satisfies [REQ-RIDE-006, REQ-RIDE-060]
                unsafe

                precondition stillSearching { RideRequest.status = searching }
                    rejects "A driver has already been assigned, so this request can no longer be cancelled free of charge"

                sets RideRequest {
                    status = cancelled
                    cancellation = CancellationDetail(
                        reason = riderBeforeAssignment,
                        cancelledBy = "rider",
                        cancelledAt = now(),
                        feeCharged = false
                    )
                }
                emits RideRequestCancelledByRider {
                    requestId = RideRequest.requestId
                    riderId = RideRequest.riderId
                    cancelledAt = now()
                }
            }

            "Cancel request — no driver available" on CancelRequestNoDriver {
                satisfies [REQ-RIDE-024]
                unsafe

                precondition searchExhausted { cancelRequestNoDriver.searchExhausted = true }
                    rejects "The search for a driver has not been exhausted yet"

                sets RideRequest {
                    status = cancelled
                    cancellation = CancellationDetail(
                        reason = noDriverAvailable,
                        cancelledBy = "system",
                        cancelledAt = now(),
                        feeCharged = false
                    )
                }
                emits NoDriverAvailable {
                    requestId = RideRequest.requestId
                    riderId = RideRequest.riderId
                    cancelledAt = now()
                }
            }
        }

        states {
            machine RideRequestLifecycle :: "From filing a request to matching or cancellation" {
                state searching
                final matched {
                    invariants {
                        hasDriver {
                            RideRequest.matchedDriverId is defined
                            enforcement rejection
                        }
                    }
                }
                final cancelled {
                    invariants {
                        hasCancellation {
                            RideRequest.cancellation is defined
                            enforcement rejection
                        }
                    }
                }

                [*]       --> searching on "Request a ride"
                searching --> matched   on "Match driver"
                searching --> cancelled on "Cancel request before assignment"
                searching --> cancelled on "Cancel request — no driver available"
            }
        }

        invariants {
            scheduledHasFutureTime :: "Scheduled rides have a future pickup time" {
                if scheduleType = scheduled { scheduledPickupTime > now() }
                enforcement rejection
            }
            matchedHasDriver :: "Matched requests have a driver" {
                if status = matched { matchedDriverId is defined }
                enforcement rejection
            }
            cancelledHasReason :: "Cancelled requests record a reason" {
                if status = cancelled { cancellation is defined }
                enforcement rejection
            }
        }
    }

    aggregate Ride :: "Ride from match through completion or cancellation" {
        satisfies [REQ-RIDE-040, REQ-RIDE-041, REQ-RIDE-042, REQ-RIDE-043, REQ-RIDE-044, REQ-RIDE-045,
                   REQ-RIDE-046, REQ-RIDE-047, REQ-RIDE-048, REQ-RIDE-049, REQ-RIDE-050,
                   REQ-RIDE-061, REQ-RIDE-063, REQ-RIDE-065, REQ-RIDE-067,
                   REQ-RIDE-080, REQ-RIDE-081, REQ-RIDE-082, REQ-RIDE-084, REQ-RIDE-085]

        identity rideId : uuid
        fields {
            rideRequestId : uuid
            riderId : uuid
            driverId : uuid
            status : RideStatus default("driverAssigned")
            pickupLocation : Location
            dropoffLocation : Location
            committedFare : FareEstimate
            estimatedDriverArrivalTime : datetime
            actualPickupLocation : Location optional
            actualPickupTime : datetime optional
            actualDropoffLocation : Location optional
            actualDropoffTime : datetime optional
            finalFare : FinalFare optional
            currentRoute : Route optional
            cancellation : CancellationDetail optional
            tripSharingLinks : list<TripSharingLink>
            createdAt : datetime
            updatedAt : datetime
        }

        entities { EmergencyEvent SafetyReport }

        operations {
            "Create ride from matched request" on CreateRide {
                satisfies [REQ-RIDE-025]
                unsafe
                sets Ride {
                    rideRequestId = createRide.requestId
                    riderId = createRide.riderId
                    driverId = createRide.driverId
                    pickupLocation = createRide.pickupLocation
                    dropoffLocation = createRide.dropoffLocation
                    committedFare = createRide.committedFare
                    estimatedDriverArrivalTime = createRide.estimatedDriverArrivalTime
                    status = driverAssigned
                    createdAt = now()
                    updatedAt = now()
                }
                emits RideCreated {
                    rideId = Ride.rideId
                    requestId = Ride.rideRequestId
                    riderId = Ride.riderId
                    driverId = Ride.driverId
                    estimatedArrival = Ride.estimatedDriverArrivalTime
                    createdAt = Ride.createdAt
                }
            }

            "Driver arrives at pickup" on SignalDriverArrival {
                satisfies [REQ-RIDE-042]
                unsafe

                precondition isAssigned { Ride.status = driverAssigned }
                    rejects "The driver is not currently assigned to this ride"

                precondition near100m { signalDriverArrival.distance.meters <= 100 }
                    rejects "The driver is more than 100 metres from the pickup point, so arrival cannot be signalled"

                sets Ride { status = driverArrived }
                emits DriverArrived {
                    rideId = Ride.rideId
                    riderId = Ride.riderId
                    driverId = Ride.driverId
                    arrivedAt = now()
                }
            }

            "Start ride" on StartRide {
                satisfies [REQ-RIDE-044]
                unsafe

                precondition driverArrived { Ride.status = driverArrived }
                    rejects "The ride cannot start before the driver has arrived at the pickup point"

                sets Ride {
                    status = inProgress
                    actualPickupLocation = startRide.pickupLocation
                    actualPickupTime = now()
                }
                emits RideStarted {
                    rideId = Ride.rideId
                    pickupLocation = Ride.actualPickupLocation
                    startedAt = Ride.actualPickupTime
                }
            }

            "Update route during trip" on UpdateRideTracking {
                satisfies [REQ-RIDE-045, REQ-RIDE-046]
                unsafe

                precondition inProgress { Ride.status = inProgress }
                    rejects "The ride is not under way, so its route cannot be updated"

                sets Ride { currentRoute = updateRideTracking.route }
                emits RideLocationUpdated {
                    rideId = Ride.rideId
                    route = Ride.currentRoute
                    updatedAt = now()
                }
            }

            "Complete ride" on CompleteRide {
                satisfies [REQ-RIDE-047, REQ-RIDE-048, REQ-RIDE-049, REQ-RIDE-050]
                unsafe

                precondition inProgress { Ride.status = inProgress }
                    rejects "Only a ride that is under way can be completed"

                sets Ride {
                    status = completed
                    actualDropoffLocation = completeRide.dropoffLocation
                    actualDropoffTime = now()
                }
                emits RideCompleted {
                    rideId = Ride.rideId
                    riderId = Ride.riderId
                    driverId = Ride.driverId
                    actualDistance = completeRide.actualDistance
                    actualDuration = completeRide.actualDuration
                    completedAt = Ride.actualDropoffTime
                }
            }

            "Rider cancels after assignment" on CancelRideByRider {
                satisfies [REQ-RIDE-061]
                unsafe

                precondition assignedOrArrived {
                    Ride.status = driverAssigned or Ride.status = driverArrived
                } rejects "The ride is already under way or finished, so the rider can no longer cancel it"

                sets Ride {
                    status = cancelled
                    cancellation = CancellationDetail(
                        reason = riderAfterAssignment,
                        cancelledBy = "rider",
                        cancelledAt = now(),
                        feeCharged = true,
                        feeAmount = cancelRideByRider.feeAmount
                    )
                }
                emits RideCancelledByRider {
                    rideId = Ride.rideId
                    riderId = Ride.riderId
                    feeAmount = Ride.cancellation.feeAmount
                    cancelledAt = now()
                }
            }

            "Driver cancels assignment" on CancelRideByDriver {
                satisfies [REQ-RIDE-063]
                unsafe

                precondition isAssigned { Ride.status = driverAssigned }
                    rejects "The driver is not currently assigned to this ride"

                sets Ride {
                    status = cancelled
                    cancellation = CancellationDetail(
                        reason = driverCancelled,
                        cancelledBy = "driver",
                        cancelledAt = now(),
                        feeCharged = false
                    )
                }
                emits RideCancelledByDriver {
                    rideId = Ride.rideId
                    riderId = Ride.riderId
                    driverId = Ride.driverId
                    cancelledAt = now()
                }
            }

            "Cancel due to rider no-show" on CancelRideRiderNoShow {
                satisfies [REQ-RIDE-043]
                unsafe

                precondition driverArrived { Ride.status = driverArrived }
                    rejects "The driver has not arrived yet, so the rider cannot be recorded as a no-show"

                precondition fiveMinutesElapsedSinceArrival {
                    now() - cancelRideRiderNoShow.arrivedAt > 5min
                } rejects "The rider still has time to board — five minutes have not passed since the driver arrived"

                sets Ride {
                    status = cancelled
                    cancellation = CancellationDetail(
                        reason = riderNoShow,
                        cancelledBy = "system",
                        cancelledAt = now(),
                        feeCharged = true,
                        feeAmount = cancelRideRiderNoShow.feeAmount
                    )
                }
                emits RideCancelledRiderNoShow {
                    rideId = Ride.rideId
                    riderId = Ride.riderId
                    feeAmount = Ride.cancellation.feeAmount
                    cancelledAt = now()
                }
            }

            "Cancel due to driver no-show" on CancelRideDriverNoShow {
                satisfies [REQ-RIDE-065, REQ-RIDE-067]
                unsafe

                precondition isAssigned { Ride.status = driverAssigned }
                    rejects "The driver is not currently assigned to this ride"

                precondition pastEtaPlusFive {
                    now() > Ride.estimatedDriverArrivalTime + 5min
                } rejects "The driver is not late yet — the estimated arrival time plus five minutes has not passed"

                sets Ride {
                    status = cancelled
                    cancellation = CancellationDetail(
                        reason = driverNoShow,
                        cancelledBy = "system",
                        cancelledAt = now(),
                        feeCharged = false
                    )
                }
                emits RideCancelledDriverNoShow {
                    rideId = Ride.rideId
                    riderId = Ride.riderId
                    driverId = Ride.driverId
                    cancelledAt = now()
                }
                // The old model published this fact from a reaction
                // (`effect publish DriverNoShowRecorded(...)`). Publication is not a
                // reaction's effect any more, so the fact is raised where it happens; the
                // Driver Management context consumes it as an external event.
                emits DriverNoShowRecorded {
                    driverId = Ride.driverId
                    rideId = Ride.rideId
                    recordedAt = now()
                }
            }

            "Activate trip sharing" on ActivateTripSharing {
                satisfies [REQ-RIDE-080]
                unsafe

                precondition isLive {
                    Ride.status = driverAssigned
                    or Ride.status = driverArrived
                    or Ride.status = inProgress
                } rejects "Trip sharing can only be turned on while the ride is live"

                sets Ride { tripSharingLinks = Ride.tripSharingLinks + activateTripSharing.link }
                emits TripSharingActivated {
                    rideId = Ride.rideId
                    link = activateTripSharing.link
                    activatedAt = now()
                }
            }

            "Trigger emergency" on TriggerEmergency {
                satisfies [REQ-RIDE-081, REQ-RIDE-082, REQ-RIDE-NFR-004]
                unsafe
                emits EmergencyTriggered {
                    rideId = Ride.rideId
                    riderId = Ride.riderId
                    driverId = Ride.driverId
                    type = triggerEmergency.type
                    location = triggerEmergency.location
                    triggeredAt = now()
                }
            }

            "Detect unusual stop" on DetectUnusualStop {
                satisfies [REQ-RIDE-084]
                unsafe

                precondition inProgress { Ride.status = inProgress }
                    rejects "Only a ride that is under way can have an unusual stop"

                precondition stoppedFiveMinutesOffRoute {
                    detectUnusualStop.stoppedSeconds > 300
                    and detectUnusualStop.offRoute = true
                } rejects "The vehicle has not been stopped off-route for five minutes"

                emits UnusualStopDetected {
                    rideId = Ride.rideId
                    location = detectUnusualStop.location
                    stoppedSeconds = detectUnusualStop.stoppedSeconds
                    detectedAt = now()
                }
            }

            "File post-ride safety report" on FileSafetyReport {
                satisfies [REQ-RIDE-085, REQ-RIDE-086]
                unsafe

                precondition rideCompleted { Ride.status = completed }
                    rejects "A safety report can only be filed once the ride has completed"

                emits SafetyReportFiled {
                    rideId = Ride.rideId
                    reportedBy = fileSafetyReport.reportedBy
                    severity = fileSafetyReport.severity
                    description = fileSafetyReport.description
                    withinWindow = (now() - Ride.actualDropoffTime <= 30days)
                    filedAt = now()
                }
            }
        }

        states {
            machine RideLifecycle :: "From driver assignment to completion or cancellation" {
                state driverAssigned
                state driverArrived
                state inProgress {
                    invariants {
                        hasPickupTime {
                            Ride.actualPickupTime is defined
                            enforcement rejection
                        }
                    }
                }
                final completed {
                    invariants {
                        hasFinalFare {
                            Ride.finalFare is defined
                            enforcement rejection
                        }
                    }
                }
                final cancelled {
                    invariants {
                        hasCancellation {
                            Ride.cancellation is defined
                            enforcement rejection
                        }
                    }
                }

                [*]            --> driverAssigned on "Create ride from matched request"
                driverAssigned --> driverArrived  on "Driver arrives at pickup"
                driverArrived  --> inProgress     on "Start ride"
                inProgress     --> completed      on "Complete ride"
                driverAssigned --> cancelled      on "Rider cancels after assignment"
                driverAssigned --> cancelled      on "Driver cancels assignment"
                driverAssigned --> cancelled      on "Cancel due to driver no-show"
                driverArrived  --> cancelled      on "Rider cancels after assignment"
                driverArrived  --> cancelled      on "Cancel due to rider no-show"
            }
        }

        invariants {
            completedHasActuals :: "Completed rides have actual times and final fare" {
                if status = completed {
                    actualPickupTime is defined
                    and actualDropoffTime is defined
                    and finalFare is defined
                }
                enforcement rejection
            }
            cancelledHasReason :: "Cancelled rides record a reason" {
                if status = cancelled { cancellation is defined }
                enforcement rejection
            }
        }
    }

    // --- Repositories (persistence ports for the aggregate roots) ---

    repository RideRequestRepository for RideRequest
        :: "Persists and retrieves ride requests" {
        satisfies [REQ-RIDE-001]
        store(rideRequest: RideRequest)
        getById(id: uuid) : RideRequest
        remove(id: uuid)
        search(criteria: RideRequestSearchCriteria) : list<RideRequest>
        findByRiderId(riderId: uuid) : list<RideRequest>
        findByStatus(status: RideRequestStatus) : list<RideRequest>
    }

    repository RideRepository for Ride
        :: "Persists and retrieves rides" {
        store(ride: Ride)
        getById(id: uuid) : Ride
        remove(id: uuid)
        search(criteria: RideSearchCriteria) : list<Ride>
        findByRiderId(riderId: uuid) : list<Ride>
        findByDriverId(driverId: uuid) : list<Ride>
    }

    // -----------------------------------------------------------------
    // Domain services
    // -----------------------------------------------------------------

    domain service MatchingService :: "Match a request to the closest eligible driver" {
        satisfies [REQ-RIDE-020, REQ-RIDE-021, REQ-RIDE-023, REQ-RIDE-024, REQ-RIDE-026, REQ-RIDE-NFR-001]
        calls { GeolocationGateway }
        operations {
            "Find and offer a driver" on FindAndOfferDriver
                :: "Offer the ride to the closest eligible driver, then roll on to the next" {
                satisfies [REQ-RIDE-020, REQ-RIDE-021, REQ-RIDE-NFR-001]
                unsafe
                resolves RideRequest from findAndOfferDriver.requestId
            }

            "Handle offer timeout" on HandleOfferTimeout
                :: "Retract the expired offer and roll on to the next driver" {
                satisfies [REQ-RIDE-023, REQ-RIDE-024]
                unsafe
                resolves RideOffer from handleOfferTimeout.offerId
            }

            getDriverAcceptanceRate(driverId: uuid) : decimal {
                satisfies [REQ-RIDE-026]
                safe
            }
        }
    }

    // -----------------------------------------------------------------
    // Infrastructure services (anti-corruption boundaries)
    // -----------------------------------------------------------------

    infrastructure service GeolocationGateway :: "ACL to GeolocationRouting" {
        satisfies [REQ-RIDE-020, REQ-RIDE-040, REQ-RIDE-045, REQ-RIDE-046]
        operations {
            // NOTE: `list<DriverRef>` had no counterpart type; the gateway returns driver ids.
            findNearbyEligibleDrivers(pickup: Location, radius: Distance) : list<uuid>
            estimateDriverArrival(driverId: uuid, pickup: Location) : datetime
            getCurrentLocation(rideId: uuid) : Location
            getCurrentRoute(rideId: uuid) : Route
            isStopOffRoute(rideId: uuid, stop: Location) : boolean
        }
    }

    infrastructure service PaymentGateway :: "ACL to Payment" {
        satisfies [REQ-RIDE-003, REQ-RIDE-048, REQ-RIDE-049, REQ-RIDE-061]
        operations {
            computeFareEstimate(pickup: Location, dropoff: Location) : FareEstimate
            computeFinalFare(rideRequestId: uuid, actualDistance: Distance, actualDuration: Duration) : FinalFare
            preAuthorize(riderId: uuid, fare: FareEstimate) : void
            capturePayment(rideId: uuid) : void
            releaseHold(rideRequestId: uuid) : void
            chargeCancellationFee(riderId: uuid, rideRequestId: uuid) : Amount
            chargeNoShowFee(riderId: uuid, rideId: uuid) : Amount
        }
    }

    infrastructure service RiderManagementGateway :: "ACL to RiderManagement" {
        satisfies [REQ-RIDE-002]
        operations {
            isReadyToRide(riderId: uuid) : boolean
        }
    }

    infrastructure service DriverManagementGateway :: "ACL to DriverManagement" {
        satisfies [REQ-RIDE-064, REQ-RIDE-066]
        operations {
            requestTemporarySuspension(driverId: uuid, duration: Duration, reason: string) : void
            getCancellationCount(driverId: uuid, windowHours: int) : int
            getNoShowCount(driverId: uuid, windowHours: int) : int
        }
    }

    infrastructure service RideNotificationService {
        satisfies [REQ-RIDE-024, REQ-RIDE-042, REQ-RIDE-067, REQ-RIDE-080, REQ-RIDE-082, REQ-RIDE-084]
        operations {
            notifyRider(riderId: uuid, message: string) : void
            notifyDriver(driverId: uuid, message: string) : void
            sendTrackingLink(contacts: list<PhoneNumber>, rideId: uuid) : void
            notifySafetyTeam(rideId: uuid, eventType: string) : void
            shareLocationWithEmergencyServices(rideId: uuid, location: Location) : void
            sendSafetyCheck(riderId: uuid, rideId: uuid, stop: Location) : void
        }
    }

    // -----------------------------------------------------------------
    // Commands
    // -----------------------------------------------------------------

    command RequestRide { identity correlationId : uuid  fields { riderId : uuid  pickupLocation : Location  dropoffLocation : Location  committedFare : FareEstimate  scheduleType : RideScheduleType  scheduledPickupTime : datetime optional  riderReadyToRide : boolean  paymentMethodValid : boolean } }
    command AcceptRideOffer { identity correlationId : uuid  fields { offerId : uuid  requestId : uuid  driverId : uuid } }
    command CancelRequestByRider { identity correlationId : uuid  fields { requestId : uuid  riderId : uuid } }
    command CancelRequestNoDriver { identity correlationId : uuid  fields { requestId : uuid  searchExhausted : boolean } }
    command CreateRide { identity correlationId : uuid  fields { requestId : uuid  riderId : uuid  driverId : uuid  pickupLocation : Location  dropoffLocation : Location  committedFare : FareEstimate  estimatedDriverArrivalTime : datetime } }
    command SignalDriverArrival { identity correlationId : uuid  fields { rideId : uuid  distance : Distance } }
    command StartRide { identity correlationId : uuid  fields { rideId : uuid  pickupLocation : Location } }
    command UpdateRideTracking { identity correlationId : uuid  fields { rideId : uuid  route : Route } }
    command CompleteRide { identity correlationId : uuid  fields { rideId : uuid  dropoffLocation : Location  actualDistance : Distance  actualDuration : Duration } }
    command CancelRideByRider { identity correlationId : uuid  fields { rideId : uuid  feeAmount : Amount } }
    command CancelRideByDriver { identity correlationId : uuid  fields { rideId : uuid } }
    command CancelRideRiderNoShow { identity correlationId : uuid  fields { rideId : uuid  arrivedAt : datetime  feeAmount : Amount } }
    command CancelRideDriverNoShow { identity correlationId : uuid  fields { rideId : uuid } }
    command ActivateTripSharing { identity correlationId : uuid  fields { rideId : uuid  link : TripSharingLink } }
    command TriggerEmergency { identity correlationId : uuid  fields { rideId : uuid  type : EmergencyEventType  location : Location } }
    command DetectUnusualStop { identity correlationId : uuid  fields { rideId : uuid  location : Location  stoppedSeconds : int  offRoute : boolean } }
    command FileSafetyReport { identity correlationId : uuid  fields { rideId : uuid  reportedBy : uuid  severity : SafetyReportSeverity  description : string } }
    command HandleOfferTimeout { identity correlationId : uuid  fields { offerId : uuid } }

    // A reaction's only legal effect is a command. The old model let a reaction call a
    // domain or infrastructure service directly; those calls become commands here.
    command FindAndOfferDriver :: "Start (or continue) matching this request to a driver" {
        identity correlationId : uuid
        fields { requestId : uuid }
    }

    // UNCLEAR: no operation targets the four commands below — the work is carried out by
    // the DriverManagementGateway and RideNotificationService adapters, whose bodies live
    // outside the domain model. The argument bindings the old service calls carried are
    // not expressible on a reaction and are recorded in each reaction's description.
    command RequestTemporaryDriverSuspension :: "Ask Driver Management to suspend a driver temporarily" {
        identity correlationId : uuid
        fields {
            driverId : uuid
            duration : Duration
            reason : string
        }
    }

    command NotifySafetyTeam :: "Raise an emergency with the safety team" {
        identity correlationId : uuid
        fields {
            rideId : uuid
            eventType : EmergencyEventType
        }
    }

    command ShareLocationWithEmergencyServices :: "Share the ride's live location with local emergency services" {
        identity correlationId : uuid
        fields {
            rideId : uuid
            location : Location
        }
    }

    command SendSafetyCheck :: "Ping the rider to check they are safe" {
        identity correlationId : uuid
        fields {
            riderId : uuid
            rideId : uuid
            stop : Location
        }
    }

    command NotifyRider :: "Send the rider a message" {
        identity correlationId : uuid
        fields {
            riderId : uuid
            message : string
        }
    }

    // -----------------------------------------------------------------
    // Events
    // -----------------------------------------------------------------

    event RideRequested {
        satisfies [REQ-RIDE-001]
        about RideRequest
        caused-by RequestRide
        fields { requestId : uuid  riderId : uuid  pickupLocation : Location  dropoffLocation : Location  committedFare : FareEstimate  scheduleType : RideScheduleType  requestedAt : datetime }
    }
    event RideRequestMatched {
        satisfies [REQ-RIDE-021, REQ-RIDE-025, REQ-RIDE-NFR-001]
        about RideRequest
        caused-by AcceptRideOffer
        fields { requestId : uuid  driverId : uuid  matchedAt : datetime }
    }
    event RideRequestCancelledByRider {
        satisfies [REQ-RIDE-006, REQ-RIDE-060]
        about RideRequest
        caused-by CancelRequestByRider
        fields { requestId : uuid  riderId : uuid  cancelledAt : datetime }
    }
    event NoDriverAvailable {
        satisfies [REQ-RIDE-024]
        about RideRequest
        caused-by CancelRequestNoDriver
        fields { requestId : uuid  riderId : uuid  cancelledAt : datetime }
    }
    event RideCreated {
        satisfies [REQ-RIDE-025]
        about Ride
        caused-by CreateRide
        fields { rideId : uuid  requestId : uuid  riderId : uuid  driverId : uuid  estimatedArrival : datetime  createdAt : datetime }
    }
    event DriverArrived {
        satisfies [REQ-RIDE-042]
        about Ride
        caused-by SignalDriverArrival
        fields { rideId : uuid  riderId : uuid  driverId : uuid  arrivedAt : datetime }
    }
    event RideStarted {
        satisfies [REQ-RIDE-044]
        about Ride
        caused-by StartRide
        fields { rideId : uuid  pickupLocation : Location  startedAt : datetime }
    }
    event RideLocationUpdated {
        satisfies [REQ-RIDE-045, REQ-RIDE-046]
        about Ride
        caused-by UpdateRideTracking
        fields { rideId : uuid  route : Route  updatedAt : datetime }
    }
    event RideCompleted {
        satisfies [REQ-RIDE-047, REQ-RIDE-048]
        about Ride
        caused-by CompleteRide
        fields { rideId : uuid  riderId : uuid  driverId : uuid  actualDistance : Distance  actualDuration : Duration  riderRating : RideRating optional  driverRating : RideRating optional  completedAt : datetime }
    }
    event RideCancelledByRider {
        satisfies [REQ-RIDE-061]
        about Ride
        caused-by CancelRideByRider
        fields { rideId : uuid  riderId : uuid  feeAmount : Amount  cancelledAt : datetime }
    }
    event RideCancelledByDriver {
        satisfies [REQ-RIDE-063]
        about Ride
        caused-by CancelRideByDriver
        fields { rideId : uuid  riderId : uuid  driverId : uuid  cancelledAt : datetime }
    }
    event RideCancelledRiderNoShow {
        satisfies [REQ-RIDE-043]
        about Ride
        caused-by CancelRideRiderNoShow
        fields { rideId : uuid  riderId : uuid  feeAmount : Amount  cancelledAt : datetime }
    }
    event RideCancelledDriverNoShow {
        satisfies [REQ-RIDE-065, REQ-RIDE-067]
        about Ride
        caused-by CancelRideDriverNoShow
        fields { rideId : uuid  riderId : uuid  driverId : uuid  cancelledAt : datetime }
    }
    event TripSharingActivated {
        satisfies [REQ-RIDE-080]
        about Ride
        caused-by ActivateTripSharing
        fields { rideId : uuid  link : TripSharingLink  activatedAt : datetime }
    }
    event EmergencyTriggered {
        satisfies [REQ-RIDE-081, REQ-RIDE-082]
        about Ride
        caused-by TriggerEmergency
        fields { rideId : uuid  riderId : uuid  driverId : uuid  type : EmergencyEventType  location : Location  triggeredAt : datetime }
    }
    event UnusualStopDetected {
        satisfies [REQ-RIDE-084]
        about Ride
        caused-by DetectUnusualStop
        fields { rideId : uuid  location : Location  stoppedSeconds : int  detectedAt : datetime }
    }
    event SafetyReportFiled {
        satisfies [REQ-RIDE-085, REQ-RIDE-086]
        about Ride
        caused-by FileSafetyReport
        fields { rideId : uuid  reportedBy : uuid  severity : SafetyReportSeverity  description : string  withinWindow : boolean  filedAt : datetime }
    }
    event DriverNoShowRecorded {
        satisfies [REQ-RIDE-067]
        about Ride
        caused-by CancelRideDriverNoShow
        fields { driverId : uuid  rideId : uuid  recordedAt : datetime }
    }

    // -----------------------------------------------------------------
    // Temporal events
    // -----------------------------------------------------------------

    // UNCLEAR: the anchor was `relative-to RideOffer.offeredAt offset 15s`. A relative
    // temporal event's `reference` must name an EVENT, and no "offer made" event is
    // modelled (offers are created inside MatchingService), so the deadline is anchored
    // on RideRequested and the offer's own timestamp is carried in the offset.
    temporal event RideOfferDeadlineElapsed :: "Offer auto-retracts after 15 seconds" {
        satisfies [REQ-RIDE-023]
        about RideOffer
        reference RideRequested
        offset RideOffer.offeredAt + 15 seconds
        guard { RideOffer.status = pending }
        fields {
            offerId : uuid
            rideRequestId : uuid
        }
    }

    temporal event RiderBoardingDeadlineElapsed :: "Rider must board within 5 min of arrival" {
        satisfies [REQ-RIDE-043]
        about Ride
        reference DriverArrived
        offset 5 minutes
        guard { Ride.status = driverArrived }
        fields {
            rideId : uuid
            arrivedAt : datetime
        }
    }

    temporal event DriverArrivalDeadlineElapsed :: "Driver no-show after ETA + 5 min" {
        satisfies [REQ-RIDE-065]
        about Ride
        reference RideCreated
        offset Ride.estimatedDriverArrivalTime + 5 minutes
        guard { Ride.status = driverAssigned }
        fields {
            rideId : uuid
        }
    }

    temporal event ScheduledRideMatchingDue :: "Begin matching 15 min before scheduled pickup" {
        satisfies [REQ-RIDE-008]
        about RideRequest
        reference RideRequested
        offset RideRequest.scheduledPickupTime - 15 minutes
        guard { RideRequest.scheduleType = scheduled and RideRequest.status = searching }
        fields {
            requestId : uuid
        }
    }

    temporal event ScheduledRideReminderDue :: "Remind rider 30 min before scheduled pickup" {
        satisfies [REQ-RIDE-009]
        about RideRequest
        reference RideRequested
        offset RideRequest.scheduledPickupTime - 30 minutes
        guard { RideRequest.scheduleType = scheduled }
        fields {
            requestId : uuid
            riderId : uuid
        }
    }

    // -----------------------------------------------------------------
    // External events
    // -----------------------------------------------------------------

    external event PaymentCaptured :: "Payment captured the fare of a completed ride" {
        from Payment
        fields {
            paymentId : uuid required
            rideId : uuid
            riderId : uuid
            capturedAt : datetime
        }
    }

    external event ETAVarianceDetected :: "Geolocation saw the remaining ETA grow unusually" {
        from GeolocationRouting
        fields {
            rideId : uuid required
            growthSeconds : int
            detectedAt : datetime
        }
    }

    // -----------------------------------------------------------------
    // Reactions
    // -----------------------------------------------------------------

    reaction StartMatchingOnRequest :: "Trigger matching as soon as the request is filed" {
        satisfies [REQ-RIDE-020]
        triggered-by RideRequested
        guard { event.scheduleType = immediate }
        effects FindAndOfferDriver
    }

    reaction StartMatchingOnScheduledLeadTime :: "Begin matching scheduled rides 15 minutes early" {
        satisfies [REQ-RIDE-008]
        triggered-by ScheduledRideMatchingDue
        effects FindAndOfferDriver
    }

    reaction CreateRideOnMatch :: "Materialize a Ride when a driver accepts; the ETA comes from GeolocationGateway.estimateDriverArrival" {
        satisfies [REQ-RIDE-025]
        triggered-by RideRequestMatched
        effects CreateRide
    }

    reaction RetractExpiredOffer :: "Retract pending offer at deadline and roll to next driver" {
        satisfies [REQ-RIDE-023]
        triggered-by RideOfferDeadlineElapsed
        effects HandleOfferTimeout
    }

    reaction CancelOnRiderNoShow :: "Cancel ride if rider has not boarded 5 min after driver arrival" {
        satisfies [REQ-RIDE-043]
        triggered-by RiderBoardingDeadlineElapsed
        effects CancelRideRiderNoShow
    }

    reaction CancelOnDriverNoShow :: "Cancel ride and rematch when driver fails to arrive" {
        satisfies [REQ-RIDE-065, REQ-RIDE-067]
        triggered-by DriverArrivalDeadlineElapsed
        effects CancelRideDriverNoShow
    }

    reaction RematchAfterDriverFault :: "Re-enter matching after driver cancellation or no-show — a clone of the original request" {
        satisfies [REQ-RIDE-067]
        triggered-by RideCancelledDriverNoShow
        effects RequestRide
    }

    reaction SuspendOnExcessiveDriverCancellations :: "Suspend driver for 30 min after >3 cancellations in 24h" {
        satisfies [REQ-RIDE-064]
        triggered-by RideCancelledByDriver
        guard { DriverManagementGateway.getCancellationCount(event.driverId, 24) > 3 }
        effects RequestTemporaryDriverSuspension
    }

    reaction SuspendOnExcessiveDriverNoShows :: "Suspend driver for 1 hour after >2 no-shows in 24h" {
        satisfies [REQ-RIDE-066]
        triggered-by RideCancelledDriverNoShow
        guard { DriverManagementGateway.getNoShowCount(event.driverId, 24) > 2 }
        effects RequestTemporaryDriverSuspension
    }

    reaction NotifySafetyTeamOnEmergency :: "Notify safety team within 60s of emergency button press" {
        satisfies [REQ-RIDE-082]
        triggered-by EmergencyTriggered
        effects NotifySafetyTeam
    }

    reaction ShareWithEmergencyServicesIfConfigured :: "Share location with local emergency services where integrated" {
        satisfies [REQ-RIDE-083]
        triggered-by EmergencyTriggered
        guard { marketSupportsEmergencyIntegration(event.rideId) }
        effects ShareLocationWithEmergencyServices
    }

    reaction SafetyCheckOnUnusualStop :: "Send safety check ping to rider on unusual stop" {
        satisfies [REQ-RIDE-084]
        triggered-by UnusualStopDetected
        effects SendSafetyCheck
    }

    reaction NotifyRiderOnDriverNoShow :: "Tell rider 'Your driver did not arrive — we are finding a new driver'" {
        satisfies [REQ-RIDE-067]
        triggered-by RideCancelledDriverNoShow
        effects NotifyRider
    }

    // -----------------------------------------------------------------
    // Agreement (cross-aggregate consistency)
    // -----------------------------------------------------------------

    agreement RideRequestRideConsistency :: "RideRequest.matched ↔ Ride exists for that request" {
        satisfies [REQ-RIDE-025]
        participants { RideRequest, Ride }
        // UNCLEAR: the original stated the property as prose — "RideRequest.status = matched
        // and not exists Ride where rideRequestId = RideRequest.requestId for > 60s". The
        // closest checkable expression is a count equality between matched requests and the
        // rides materialized from them; the 60-second grace period cannot be expressed in a
        // predicate and lives in the reconciliation instead.
        predicate { count(RideRequest.matched) = count(Ride.rideRequestId) }
        reconciliation OrphanRideOrUnmaterializedMatch :: "Detect requests in matched status without a Ride" {
            trigger event RideRequestMatched
            detection query
            compensation { CreateRide }
            coordination orchestration
            escalation :: "Operator review first, then engineering on-call" {
                step operatorReviewQueue {
                    when { true }
                    action compensate { CreateRide }
                }
                step engineeringOnCall {
                    when { true }
                    action manual "Engineering on-call reconciles the orphaned match by hand"
                }
            }
        }
    }
}
