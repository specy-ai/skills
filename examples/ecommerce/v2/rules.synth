// Conditional realism: a row drawn attribute by attribute. The value of one field
// decides how the next is drawn (a rule with `when`), fixed values are drawn
// `among`, and composed text comes from a grammar written once as data. None of it
// is a fact: an outcome always wins, and the certificate's plausibility section
// observes each rule where it applies.
scenario OrdersRules :: "Six months of orders where the currency follows the country, five-star products cost more, cancelled orders paid by bank transfer, and product names come from a grammar." {
    domain-source "orders.domain"
    seed 42
    horizon 2025-01-01 .. 2025-07-01
    as-of 2025-07-01T00:00:00Z

    populations {
        Customer  count 200
        Product   count 60
        Order     count 1200
        OrderLine per Order 1..5
        Payment   per Order exactly 1
    }

    outcomes {
        curve monthlyRevenue Order.totalAmount.amount by Order.placedAt per month {
            2025-01: 180000
            2025-02: 195000
            2025-03: 210000
            2025-04: 205000
            2025-05: 230000
            2025-06: 260000
        }
        mix Order.OrderLifecycle {
            delivered: 72%
            shipped:    6%
            confirmed:  8%
            draft:      4%
            cancelled: 10%
        }
        rollup Order.totalAmount.amount from OrderLine.total.amount
        rate Product.available = true : 90%
    }

    vocabulary {
        locale "en-GB"
        Product.name        grammar "vocab/product-names.json"                          :: "composed, not listed"
        Product.description grammar "vocab/blurbs.json" by Product.available            :: "in stock or sold out"
    }

    distributions {
        // the field a rule reads is drawn before the field it shapes
        Product.price.amount                                                   lognormal median 30 sigma 0.6
        Product.price.amount when Product.rating = 5                           lognormal median 120 sigma 0.4
        Product.stockQuantity when Product.available = false                   among [ 0 ]
        Order.totalAmount.currency when Order.shippingAddress.country = GB     among [ GBP ]
        // the per parent's state; a bankTransferMinimum invariant may still override small orders
        Payment.method                                                         among [ creditCard: 65%, paypal: 30%, bankTransfer: 5% ]
        Payment.method when Order.status = cancelled                           among [ bankTransfer: 80%, paypal: 20% ]
    }

    options {
        dwell {
            draft     --> confirmed : 4h
            confirmed --> shipped   : 2d
            shipped   --> delivered : 3d
            draft     --> cancelled : 1d
            confirmed --> cancelled : 1d
        }
    }
}
