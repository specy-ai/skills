// Realism through references: a row's values reach the rows it references. The
// order ships to its customer's address (a copy through the `customer` reference),
// suspended customers' orders are billed in euros (a condition through the same
// reference), and the payment's failure text follows its order's state (a grammar
// started by a field read through a reference). None of it is a fact: an outcome
// always wins, and the certificate's plausibility section observes each rule through
// the join it reads across.
scenario OrdersLinks :: "Six months of orders shipped to their customer's address, billed in euros for suspended customers, with payment failure texts that follow the order's state." {
    domain-source "orders.domain"
    seed 42
    horizon 2025-01-01 .. 2025-07-01
    as-of 2025-07-01T00:00:00Z

    populations {
        Customer  count 200
        Product   count 60
        Order     count 1200
        OrderLine per Order 1..5
        Payment   per Order exactly 1
    }

    outcomes {
        curve monthlyRevenue Order.totalAmount.amount by Order.placedAt per month {
            2025-01: 180000
            2025-02: 195000
            2025-03: 210000
            2025-04: 205000
            2025-05: 230000
            2025-06: 260000
        }
        mix Order.OrderLifecycle {
            delivered: 72%
            shipped:    6%
            confirmed:  8%
            draft:      4%
            cancelled: 10%
        }
        rollup Order.totalAmount.amount from OrderLine.total.amount
        rate Customer.status = suspended : 10%
    }

    vocabulary {
        locale "en-GB"
        Payment.failureReason grammar "vocab/failure-reasons.json" by Payment.order.status :: "the order's state picks the symbol"
    }

    distributions {
        // a copy through a declared reference: the whole Address value, every column
        Order.shippingAddress from Order.customer.shippingAddress
        // a condition through the same reference
        Order.totalAmount.currency when Order.customer.status = suspended   among [ EUR ]
        Order.totalAmount.currency when Order.shippingAddress.country = GB  among [ GBP ]
    }

    options {
        dwell {
            draft     --> confirmed : 4h
            confirmed --> shipped   : 2d
            shipped   --> delivered : 3d
            draft     --> cancelled : 1d
            confirmed --> cancelled : 1d
        }
    }
}
