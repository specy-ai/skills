/.idea/
**/.DS_STore
proposals
*.pptx
src/langium/specy-domain/node_modules/
package-lock.json

# Vim swapfiles
*.swp
# Claude Code local worktrees
.claude/worktrees/
# Compiled tree-sitter parsers
*.so
# Compiled Langium parser + language server — rebuilt by
# src/langium/specy-domain/build.sh (which the root build.sh calls, and which
# parse-domain.sh triggers on first use).
src/langium/specy-domain/out/
# Skill-creator eval/optimization scratch output
src/skills/*/workspace/

# Client domain models used by the ui/ navigator prototype — kept local,
# the repo ships the anonymized equivalents in examples/business-loan/.
ui/fipro.*
ui/ffm.*
# Every model the navigator serves from ui/ stays local (client files, merged
# landscapes, symlinks to examples/) — the navigator skips a missing file.
ui/**/*.arch
ui/**/*.domain
